(load "git@github.com:carpentry-org/strbuf@0.1.0")

(doc Parser "is a Parsec-style parser combinator library for Carp.

## Installation

```
(load \"git@github.com:carpentry-org/parsec@0.3.0\")
```

## Usage

```
(let [p (Parser.seq (Parser.byte \\h) (Parser.byte \\i))]
  (match (Parser.parse p \"hi\")
    (Result.Success _) (println \"matched\")
    (Result.Error e)   (IO.errorln &(Parser.format-error &e))))
```")

(doc Cursor "is a cursor over the parser input: `pos` (byte offset),
`line`, and `col`. Newline-aware: `\\n` advances `line` and resets
`col` to 1. Users mostly see `Cursor` values via `ParseErr` for error
reporting.")
(deftype Cursor [pos Int
                 line Int
                 col Int])
(derive Cursor =)

(defmodule Cursor
  (doc zero "is the initial cursor: `pos=0`, `line=1`, `col=1`.")
  (defn zero [] (Cursor.init 0 1 1))

  (doc advance "advances the cursor past one byte. If the byte is a
newline, `line` increments and `col` resets to 1.")
  (defn advance [cur b]
    (if (Char.= b \newline)
      (Cursor.init (Int.inc @(Cursor.pos cur)) (Int.inc @(Cursor.line cur)) 1)
      (Cursor.init (Int.inc @(Cursor.pos cur))
                   @(Cursor.line cur)
                   (Int.inc @(Cursor.col cur)))))

  (hidden advance-by)
  (doc advance-by "advances the cursor past `n` bytes, treating the
whole span as one column. If `newline?` is true, `line` is bumped
instead. Used by UTF-8 codepoint parsers.")
  (defn advance-by [cur n newline?]
    (if newline?
      (Cursor.init (Int.+ @(Cursor.pos cur) n) (Int.inc @(Cursor.line cur)) 1)
      (Cursor.init (Int.+ @(Cursor.pos cur) n)
                   @(Cursor.line cur)
                   (Int.inc @(Cursor.col cur))))))

(doc Expected "is the set of labels carried by a `ParseErr`. The
common case (a single failing primitive) uses `One` to skip a
1-element `Array` allocation; merged failures collected by `choice`
use `Many`.")
(deftype Expected
  (One [String])
  (Many [(Array String)]))

(defmodule Expected
  (doc empty "is the empty expected-set.")
  (defn empty [] (Expected.Many []))

  (doc to-array "materializes an `Expected` as an `Array String`.
Allocates a 1-element array for the `One` case.")
  (defn to-array [e] (match-ref e (One s) [@s] (Many a) @a))

  (doc length "number of labels in the set.")
  (defn length [e] (match-ref e (One _) 1 (Many a) (Array.length a)))

  (doc append-into "drains the labels in `e` onto the end of `acc`,
returning the new array. Used by `Parser.choice` to accumulate
labels across failed alternatives without going through
`to-array`'s allocation in the `One` case.")
  (defn append-into [acc e]
    (match-ref e
      (One s) (Array.push-back acc @s)
      (Many a)
        (let-do [out acc
                 n (Array.length a)]
          (for [j 0 n] (set! out (Array.push-back out @(Array.unsafe-nth a j))))
          out))))

(doc ParseErr "is a parser failure carrying byte/line/column position,
an optional `unexpected` token, and an `expected` set of labels
gathered from parsers that failed at that position. Render with
`Parser.format-error`.")
(deftype ParseErr
  [pos Int
   line Int
   col Int
   unexpected (Maybe String)
   expected Expected])

(defmodule ParseErr
  (doc empty-at "creates a `ParseErr` at `cur` with no labels.")
  (defn empty-at [cur]
    (ParseErr.init @(Cursor.pos cur)
                   @(Cursor.line cur)
                   @(Cursor.col cur)
                   (Maybe.Nothing)
                   (Expected.empty)))

  (doc expected-at "creates a `ParseErr` at `cur` with one expected label.")
  (defn expected-at [cur lbl]
    (ParseErr.init @(Cursor.pos cur)
                   @(Cursor.line cur)
                   @(Cursor.col cur)
                   (Maybe.Nothing)
                   (Expected.One lbl)))

  (hidden merge)
  (doc merge "merges two `ParseErr`s by unioning their expected
sets. Position is taken from `b`.")
  (defn merge [a b]
    (let [exp (Expected.Many
            (Array.concat
              &[(Expected.to-array (ParseErr.expected &a))
                (Expected.to-array (ParseErr.expected &b))]))
          unx (match @(ParseErr.unexpected &b)
            (Maybe.Just s) (Maybe.Just s)
            (Maybe.Nothing) @(ParseErr.unexpected &a))]
      (ParseErr.init @(ParseErr.pos &b)
                     @(ParseErr.line &b)
                     @(ParseErr.col &b)
                     unx
                     exp))))

(doc Reply "is the 4-case result of running a parser: `OkConsumed`,
`OkEmpty`, `ErrConsumed`, `ErrEmpty`. The consumed/empty distinction
drives Parsec-style backtracking. `Parser.parse` collapses this into
a `Result`; `Reply` surfaces only when writing custom combinators
that call `Parser.run` directly.")
(deftype (Reply a)
  (OkConsumed [a Cursor])
  (OkEmpty [a Cursor])
  (ErrConsumed [ParseErr])
  (ErrEmpty [ParseErr]))

(deftype (Parser a) [run (Fn [(Ref String) Int (Ref Cursor)] (Reply a))])

(defmodule Parser
  (doc pure "succeeds without consuming, producing the given value.")
  (defn pure [x] (Parser.init (fn [src len cur] (Reply.OkEmpty @&x @cur))))

  (doc fail "fails empty, with the given label as the expected token.")
  (defn fail [lbl]
    (Parser.init
      (fn [src len cur] (Reply.ErrEmpty (ParseErr.expected-at cur @&lbl)))))

  (doc satisfy "consumes one byte if `pred` holds, otherwise fails empty.
When the predicate rejects a byte, the error's `unexpected` field is
populated with the byte that was seen.")
  (defn satisfy [pred lbl]
    (Parser.init
      (fn [src len cur]
        (let [pos @(Cursor.pos cur)]
          (if (Int.>= pos len)
            (Reply.ErrEmpty (ParseErr.expected-at cur @&lbl))
            (let [c (String.char-at src pos)]
              (if (pred c)
                (Reply.OkConsumed c (Cursor.advance cur c))
                (Reply.ErrEmpty
                  (ParseErr.init @(Cursor.pos cur)
                                 @(Cursor.line cur)
                                 @(Cursor.col cur)
                                 (Maybe.Just (fmt "'%c'" c))
                                 (Expected.One @&lbl))))))))))

  (doc byte "consumes a specific byte (as `Char`). Fails empty if
the input doesn't match or is at EOF.")
  (defn byte [b]
    (let [lbl (fmt "'%c'" b)]
      (Parser.init
        (fn [src len cur]
          (let [pos @(Cursor.pos cur)]
            (if (Int.>= pos len)
              (Reply.ErrEmpty (ParseErr.expected-at cur @&lbl))
              (let [c (String.char-at src pos)]
                (if (Char.= c b)
                  (Reply.OkConsumed c (Cursor.advance cur c))
                  (Reply.ErrEmpty (ParseErr.expected-at cur @&lbl))))))))))

  (doc any-byte "consumes any byte; fails only at end of input.")
  (defn any-byte []
    (Parser.init
      (fn [src len cur]
        (let [pos @(Cursor.pos cur)]
          (if (Int.>= pos len)
            (Reply.ErrEmpty (ParseErr.expected-at cur @"any byte"))
            (let [c (String.char-at src pos)]
              (Reply.OkConsumed c (Cursor.advance cur c))))))))

  (doc eof "succeeds without consuming iff the cursor is at end of input.
When the input is not at end, the error's `unexpected` field is
populated with the byte that was seen.")
  (defn eof []
    (Parser.init
      (fn [src len cur]
        (if (Int.>= @(Cursor.pos cur) len)
          (Reply.OkEmpty () @cur)
          (let [c (String.char-at src @(Cursor.pos cur))]
            (Reply.ErrEmpty
              (ParseErr.init @(Cursor.pos cur)
                             @(Cursor.line cur)
                             @(Cursor.col cur)
                             (Maybe.Just (fmt "'%c'" c))
                             (Expected.One @"end of input"))))))))

  (doc map "applies `f` to the value produced by `p`.")
  (defn map [p f]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.OkConsumed v c) (Reply.OkConsumed (f v) c)
          (Reply.OkEmpty v c) (Reply.OkEmpty (f v) c)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)))))

  (doc seq "runs `p` then `q`, returning a `Pair` of their values.
Failure of either propagates with appropriate consumption tracking.")
  (defn seq [p q]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1)
            (match (~(Parser.run &q) src len &c1)
              (Reply.OkConsumed v2 c2) (Reply.OkConsumed (Pair.init v1 v2) c2)
              (Reply.OkEmpty v2 c2) (Reply.OkConsumed (Pair.init v1 v2) c2)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e)
              (Reply.ErrEmpty e) (Reply.ErrConsumed e))
          (Reply.OkEmpty v1 c1)
            (match (~(Parser.run &q) src len &c1)
              (Reply.OkConsumed v2 c2) (Reply.OkConsumed (Pair.init v1 v2) c2)
              (Reply.OkEmpty v2 c2) (Reply.OkEmpty (Pair.init v1 v2) c2)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e)
              (Reply.ErrEmpty e) (Reply.ErrEmpty e))))))

  (doc bind "is the monadic bind. Runs `p`, then runs `(f v)` where
`v` is `p`'s value. The continuation parser is computed from the
value.")
  (defn bind [p f]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1)
            (let [q (f v1)]
              (match (~(Parser.run &q) src len &c1)
                (Reply.OkConsumed v2 c2) (Reply.OkConsumed v2 c2)
                (Reply.OkEmpty v2 c2) (Reply.OkConsumed v2 c2)
                (Reply.ErrConsumed e) (Reply.ErrConsumed e)
                (Reply.ErrEmpty e) (Reply.ErrConsumed e)))
          (Reply.OkEmpty v1 c1)
            (let [q (f v1)]
              (match (~(Parser.run &q) src len &c1)
                (Reply.OkConsumed v2 c2) (Reply.OkConsumed v2 c2)
                (Reply.OkEmpty v2 c2) (Reply.OkEmpty v2 c2)
                (Reply.ErrConsumed e) (Reply.ErrConsumed e)
                (Reply.ErrEmpty e) (Reply.ErrEmpty e)))))))

  (doc bind-result "runs `p`, then applies `f` to its value and the
cursor *after* `p`. `f` returns a `(Result b ParseErr)` directly,
avoiding a per-parse `Parser.pure`/`Parser.fail` rebuild that the
equivalent `bind` formulation would do. The cursor argument lets `f`
build a `ParseErr` at the right position when it returns
`Result.Error`.")
  (defn bind-result [p f]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v c)
            (match (f v &c)
              (Result.Success r) (Reply.OkConsumed r c)
              (Result.Error e) (Reply.ErrConsumed e))
          (Reply.OkEmpty v c)
            (match (f v &c)
              (Result.Success r) (Reply.OkEmpty r c)
              (Result.Error e) (Reply.ErrEmpty e))))))

  (doc then "runs `p` then `q`, discarding `p`'s value and returning
`q`'s. Equivalent to `(bind p (fn [_] q))` but does not allocate the
continuation closure per parse.")
  (defn then [p q]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed _ c1)
            (match (~(Parser.run &q) src len &c1)
              (Reply.OkConsumed v c2) (Reply.OkConsumed v c2)
              (Reply.OkEmpty v c2) (Reply.OkConsumed v c2)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e)
              (Reply.ErrEmpty e) (Reply.ErrConsumed e))
          (Reply.OkEmpty _ c1)
            (match (~(Parser.run &q) src len &c1)
              (Reply.OkConsumed v c2) (Reply.OkConsumed v c2)
              (Reply.OkEmpty v c2) (Reply.OkEmpty v c2)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e)
              (Reply.ErrEmpty e) (Reply.ErrEmpty e))))))

  (doc before "runs `p` then `q`, returning `p`'s value and discarding
`q`'s. The mirror image of `then`.")
  (defn before [p q]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v c1)
            (match (~(Parser.run &q) src len &c1)
              (Reply.OkConsumed _ c2) (Reply.OkConsumed v c2)
              (Reply.OkEmpty _ c2) (Reply.OkConsumed v c2)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e)
              (Reply.ErrEmpty e) (Reply.ErrConsumed e))
          (Reply.OkEmpty v c1)
            (match (~(Parser.run &q) src len &c1)
              (Reply.OkConsumed _ c2) (Reply.OkConsumed v c2)
              (Reply.OkEmpty _ c2) (Reply.OkEmpty v c2)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e)
              (Reply.ErrEmpty e) (Reply.ErrEmpty e))))))

  (doc alt "if `p` fails without consuming, runs `q` from the same
cursor. If `p` consumes anything, no backtrack — wrap `p` in `try`
to allow backtracking.")
  (defn alt [p q]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.OkConsumed v c) (Reply.OkConsumed v c)
          (Reply.OkEmpty v c) (Reply.OkEmpty v c)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.ErrEmpty e1)
            (match (~(Parser.run &q) src len cur)
              (Reply.OkConsumed v c) (Reply.OkConsumed v c)
              (Reply.OkEmpty v c) (Reply.OkEmpty v c)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e)
              (Reply.ErrEmpty e2) (Reply.ErrEmpty (ParseErr.merge e1 e2)))))))

  (doc try "if `p` fails after consuming, restores the cursor and
reports the failure as empty so `alt` can backtrack.")
  (defn try [p]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.OkConsumed v c) (Reply.OkConsumed v c)
          (Reply.OkEmpty v c) (Reply.OkEmpty v c)
          (Reply.ErrConsumed e) (Reply.ErrEmpty e)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)))))

  (doc lazy "defers parser construction until run time. Use this to
break eager-construction infinite recursion in recursive grammars.

The thunk must call a sibling function, not the immediately enclosing
one. Pattern: split a recursive grammar into two functions, with the
lazy thunk in one calling the other.

```
(sig sexp (Fn [] (Parser SExp)))
(defn list-p []
  (Parser.between open close
    (Parser.many (Parser.lazy (fn [] (sexp))))))
(defn sexp [] (Parser.alt (atom-p) (list-p)))
```

Each invocation rebuilds the deferred parser. For deep recursion, prefer
`Parser.recurse` against a pre-built grammar in a top-level `def`.")
  (defn lazy [thunk]
    (Parser.init
      (fn [src len cur] (let [p (thunk)] (~(Parser.run &p) src len cur)))))

  (doc recurse "runs a parser referenced by a stable static reference,
without rebuilding it per call. Use for deeply recursive grammars where
`lazy` would rebuild the parser tree at every level.

Pattern: declare the recursive grammar in a top-level `def`, set! it
once at startup, and reference it from sub-parsers via `recurse`.

```
(def *sexp* (the (Parser SExp) (Parser.placeholder)))

(defn list-p []
  (Parser.between open close
    (Parser.many (Parser.recurse &*sexp*))))

(defn init-grammar []
  (set! *sexp* (Parser.alt (atom-p) (list-p))))
```

The grammar must be initialized via `set!` before parsing.")
  (defn recurse [pref]
    (Parser.init (fn [src len cur] (~(Parser.run pref) src len cur))))

  (doc placeholder "is an uninitialized parser that always fails.
Use as the initial value for a top-level `def` that will be `set!` to
the real parser before parsing. Companion to `recurse`.")
  (defn placeholder [] (fail @"uninitialized parser"))

  (doc label "replaces the expected-set on empty failure with
`name`. Has no effect on consumed failures or successes.")
  (defn label [name p]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.OkConsumed v c) (Reply.OkConsumed v c)
          (Reply.OkEmpty v c) (Reply.OkEmpty v c)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.ErrEmpty e)
            (Reply.ErrEmpty
              (ParseErr.init @(ParseErr.pos &e)
                             @(ParseErr.line &e)
                             @(ParseErr.col &e)
                             @(ParseErr.unexpected &e)
                             (Expected.One @&name)))))))

  (private string-match)
  (hidden string-match)
  (doc string-match "shared helper for `string` and `string-ci`. Matches the
literal `s` against the input using `cmp` to compare each character pair.
Returns the matched input slice on success.")
  (defn string-match [s lbl cmp]
    (let [slen (String.length &s)]
      (Parser.init
        (fn [src len cur]
          (let [pos @(Cursor.pos cur)]
            (if (Int.> (Int.+ pos slen) len)
              (Reply.ErrEmpty (ParseErr.expected-at cur @&lbl))
              (let-do [matches true]
                (for [i 0 slen]
                  (unless (cmp (String.char-at &s i)
                               (String.char-at src (Int.+ pos i)))
                    (set! matches false)))
                (if matches
                  (let-do [c @cur]
                    (for [i 0 slen]
                      (set! c
                            (Cursor.advance &c
                                            (String.char-at src (Int.+ pos i)))))
                    (if (Int.> slen 0)
                      (Reply.OkConsumed
                        (String.byte-slice src pos (Int.+ pos slen))
                        c)
                      (Reply.OkEmpty
                        (String.byte-slice src pos (Int.+ pos slen))
                        c)))
                  (Reply.ErrEmpty (ParseErr.expected-at cur @&lbl))))))))))

  (doc string "matches the literal string `s` byte-for-byte.
Atomic: on partial mismatch, fails empty (no consumed failure
mid-string).")
  (defn string [s] (let [lbl (fmt "\"%s\"" &s)] (string-match s lbl Char.=)))

  (doc optional "if `p` succeeds, wraps the value in `Just`; if `p`
fails empty, succeeds with `Nothing` without consuming. Consumed
failures propagate.")
  (defn optional [p]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.OkConsumed v c) (Reply.OkConsumed (Maybe.Just v) c)
          (Reply.OkEmpty v c) (Reply.OkEmpty (Maybe.Just v) c)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.ErrEmpty e) (Reply.OkEmpty (Maybe.Nothing) @cur)))))

  (doc option "tries `p`; on empty failure, returns `default` without
consuming. On consumed failure, propagates. On success, returns
`p`'s value. Like `optional` but yields a concrete default instead
of `Maybe`.")
  (defn option [default p]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.OkConsumed v c) (Reply.OkConsumed v c)
          (Reply.OkEmpty v c) (Reply.OkEmpty v c)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.ErrEmpty _) (Reply.OkEmpty @&default @cur)))))

  (doc skip "runs `p` and discards its value, returning `()`.
Useful for running a parser purely for its consumption effect.")
  (defn skip [p]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.OkConsumed _ c) (Reply.OkConsumed () c)
          (Reply.OkEmpty _ c) (Reply.OkEmpty () c)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)))))

  (doc lookahead "runs `p`, then restores the cursor. `p`'s value
is kept, but no input is consumed. `p`'s failures propagate as-is.")
  (defn lookahead [p]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.OkConsumed v _) (Reply.OkEmpty v @cur)
          (Reply.OkEmpty v _) (Reply.OkEmpty v @cur)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)))))

  (doc not-followed-by "succeeds (without consuming) if `p` fails;
fails if `p` succeeds. Useful for negative assertions.")
  (defn not-followed-by [p]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.OkConsumed _ _)
            (Reply.ErrEmpty (ParseErr.expected-at cur @"unexpected match"))
          (Reply.OkEmpty _ _)
            (Reply.ErrEmpty (ParseErr.expected-at cur @"unexpected match"))
          (Reply.ErrConsumed _) (Reply.OkEmpty () @cur)
          (Reply.ErrEmpty _) (Reply.OkEmpty () @cur)))))

  (doc count "runs `p` exactly `n` times, collecting results into
an `Array`. If any iteration fails, propagates with appropriate
consumption.")
  (defn count [n p]
    (Parser.init
      (fn [src len cur]
        (let-do [acc []
                 c @cur
                 err (the (Maybe ParseErr) (Maybe.Nothing))
                 consumed-any false
                 i 0
                 going true]
          (while-do (and going (Int.< i n))
            (match (~(Parser.run &p) src len &c)
              (Reply.OkConsumed v c2)
                (do
                  (set! acc (Array.push-back acc v))
                  (set! c c2)
                  (set! consumed-any true))
              (Reply.OkEmpty v c2)
                (do (set! acc (Array.push-back acc v)) (set! c c2))
              (Reply.ErrEmpty e)
                (do (set! err (Maybe.Just e)) (set! going false))
              (Reply.ErrConsumed e)
                (do (set! err (Maybe.Just e)) (set! going false)))
            (set! i (Int.inc i)))
          (match err
            (Maybe.Just e)
              (if consumed-any (Reply.ErrConsumed e) (Reply.ErrEmpty e))
            (Maybe.Nothing)
              (if consumed-any (Reply.OkConsumed acc c) (Reply.OkEmpty acc c)))))))

  (doc at-most "runs `p` up to `n` times, collecting results into an
`Array`. Stops early if `p` fails empty or succeeds without consuming
(same guard as `many`). Consumed failures propagate. Use `count` for
exactly `n` repetitions that may succeed empty.")
  (defn at-most [n p]
    (Parser.init
      (fn [src len cur]
        (let-do [acc []
                 c @cur
                 err (the (Maybe ParseErr) (Maybe.Nothing))
                 consumed-any false
                 i 0
                 going true]
          (while-do (and going (Int.< i n))
            (match (~(Parser.run &p) src len &c)
              (Reply.OkConsumed v c2)
                (do
                  (set! acc (Array.push-back acc v))
                  (set! c c2)
                  (set! consumed-any true))
              (Reply.OkEmpty _ _) (set! going false)
              (Reply.ErrEmpty _) (set! going false)
              (Reply.ErrConsumed e)
                (do (set! err (Maybe.Just e)) (set! going false)))
            (set! i (Int.inc i)))
          (match err
            (Maybe.Just e) (Reply.ErrConsumed e)
            (Maybe.Nothing)
              (if consumed-any (Reply.OkConsumed acc c) (Reply.OkEmpty acc c)))))))

  (doc at-least "runs `p` at least `n` times, then continues greedily
like `many`. Fails if `p` doesn't match at least `n` times. After the
minimum, stops on empty failure or empty success to avoid infinite
recursion.")
  (defn at-least [n p]
    (Parser.init
      (fn [src len cur]
        (let-do [acc []
                 c @cur
                 err (the (Maybe ParseErr) (Maybe.Nothing))
                 consumed-any false
                 i 0
                 going true]
          (while-do (and going (Int.< i n))
            (match (~(Parser.run &p) src len &c)
              (Reply.OkConsumed v c2)
                (do
                  (set! acc (Array.push-back acc v))
                  (set! c c2)
                  (set! consumed-any true))
              (Reply.OkEmpty v c2)
                (do (set! acc (Array.push-back acc v)) (set! c c2))
              (Reply.ErrEmpty e)
                (do (set! err (Maybe.Just e)) (set! going false))
              (Reply.ErrConsumed e)
                (do (set! err (Maybe.Just e)) (set! going false)))
            (set! i (Int.inc i)))
          (while-do going
            (match (~(Parser.run &p) src len &c)
              (Reply.OkConsumed v c2)
                (do
                  (set! acc (Array.push-back acc v))
                  (set! c c2)
                  (set! consumed-any true))
              (Reply.OkEmpty _ _) (set! going false)
              (Reply.ErrEmpty _) (set! going false)
              (Reply.ErrConsumed e2)
                (do (set! err (Maybe.Just e2)) (set! going false))))
          (match err
            (Maybe.Just e)
              (if consumed-any (Reply.ErrConsumed e) (Reply.ErrEmpty e))
            (Maybe.Nothing)
              (if consumed-any (Reply.OkConsumed acc c) (Reply.OkEmpty acc c)))))))

  (doc many "runs `p` zero or more times, collecting results. Stops
on empty failure of `p`. If `p` succeeds without consuming, the loop
stops to avoid infinite recursion (do not use `many` with an
empty-success parser).")
  (defn many [p]
    (Parser.init
      (fn [src len cur]
        (let-do [acc []
                 c @cur
                 err (the (Maybe ParseErr) (Maybe.Nothing))
                 consumed-any false
                 going true]
          (while-do going
            (match (~(Parser.run &p) src len &c)
              (Reply.OkConsumed v c2)
                (do
                  (set! acc (Array.push-back acc v))
                  (set! c c2)
                  (set! consumed-any true))
              (Reply.OkEmpty _ _) (set! going false)
              (Reply.ErrEmpty _) (set! going false)
              (Reply.ErrConsumed e2)
                (do (set! err (Maybe.Just e2)) (set! going false))))
          (match err
            (Maybe.Just e) (Reply.ErrConsumed e)
            (Maybe.Nothing)
              (if consumed-any (Reply.OkConsumed acc c) (Reply.OkEmpty acc c)))))))

  (doc many1 "runs `p` one or more times. Fails (with same
consumption as `p`'s first failure) if `p` doesn't match at least
once.")
  (defn many1 [p]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1)
            (let-do [acc [v1]
                     c c1
                     err (the (Maybe ParseErr) (Maybe.Nothing))
                     going true]
              (while-do going
                (match (~(Parser.run &p) src len &c)
                  (Reply.OkConsumed v c2)
                    (do (set! acc (Array.push-back acc v)) (set! c c2))
                  (Reply.OkEmpty _ _) (set! going false)
                  (Reply.ErrEmpty _) (set! going false)
                  (Reply.ErrConsumed e2)
                    (do (set! err (Maybe.Just e2)) (set! going false))))
              (match err
                (Maybe.Just e) (Reply.ErrConsumed e)
                (Maybe.Nothing) (Reply.OkConsumed acc c)))
          (Reply.OkEmpty v1 c1) (Reply.OkEmpty [v1] c1)))))

  (doc skip-many "runs `p` zero or more times, discarding all
results. Returns `()`. Avoids building an `Array`, saving
allocations compared to `many`. Stops on empty failure of `p`.")
  (defn skip-many [p]
    (Parser.init
      (fn [src len cur]
        (let-do [c @cur
                 err (the (Maybe ParseErr) (Maybe.Nothing))
                 consumed-any false
                 going true]
          (while-do going
            (match (~(Parser.run &p) src len &c)
              (Reply.OkConsumed _ c2) (do (set! c c2) (set! consumed-any true))
              (Reply.OkEmpty _ _) (set! going false)
              (Reply.ErrEmpty _) (set! going false)
              (Reply.ErrConsumed e2)
                (do (set! err (Maybe.Just e2)) (set! going false))))
          (match err
            (Maybe.Just e) (Reply.ErrConsumed e)
            (Maybe.Nothing)
              (if consumed-any (Reply.OkConsumed () c) (Reply.OkEmpty () c)))))))

  (doc skip-many1 "runs `p` one or more times, discarding all
results. Returns `()`. Fails if the first application of `p` fails.")
  (defn skip-many1 [p]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed _ c1)
            (let-do [c c1
                     err (the (Maybe ParseErr) (Maybe.Nothing))
                     going true]
              (while-do going
                (match (~(Parser.run &p) src len &c)
                  (Reply.OkConsumed _ c2) (set! c c2)
                  (Reply.OkEmpty _ _) (set! going false)
                  (Reply.ErrEmpty _) (set! going false)
                  (Reply.ErrConsumed e2)
                    (do (set! err (Maybe.Just e2)) (set! going false))))
              (match err
                (Maybe.Just e) (Reply.ErrConsumed e)
                (Maybe.Nothing) (Reply.OkConsumed () c)))
          (Reply.OkEmpty _ c1) (Reply.OkEmpty () c1)))))

  (doc many-till "runs `p` repeatedly until `end` succeeds, collecting
`p` results in an `Array`. Returns the array (not the `end` result).
The `end` parser is tried before each `p`. If `end` can consume on
failure, wrap it in `try`.")
  (defn many-till [p end]
    (Parser.init
      (fn [src len cur]
        (let-do [acc []
                 c @cur
                 err (the (Maybe ParseErr) (Maybe.Nothing))
                 consumed-any false
                 going true]
          (while-do going
            (match (~(Parser.run &end) src len &c)
              (Reply.OkConsumed _ c2)
                (do (set! c c2) (set! consumed-any true) (set! going false))
              (Reply.OkEmpty _ c2) (do (set! c c2) (set! going false))
              (Reply.ErrConsumed e2)
                (do
                  (set! err (Maybe.Just e2))
                  (set! consumed-any true)
                  (set! going false))
              (Reply.ErrEmpty _)
                (match (~(Parser.run &p) src len &c)
                  (Reply.OkConsumed v c2)
                    (do
                      (set! acc (Array.push-back acc v))
                      (set! c c2)
                      (set! consumed-any true))
                  (Reply.OkEmpty v c2)
                    (do (set! acc (Array.push-back acc v)) (set! c c2))
                  (Reply.ErrConsumed e2)
                    (do
                      (set! err (Maybe.Just e2))
                      (set! consumed-any true)
                      (set! going false))
                  (Reply.ErrEmpty e2)
                    (do (set! err (Maybe.Just e2)) (set! going false)))))
          (match err
            (Maybe.Just e)
              (if consumed-any (Reply.ErrConsumed e) (Reply.ErrEmpty e))
            (Maybe.Nothing)
              (if consumed-any (Reply.OkConsumed acc c) (Reply.OkEmpty acc c)))))))

  (doc between "runs `open`, then `p`, then `close`, returning
`p`'s value. Once `open` consumes, all subsequent failures are
consumed failures.")
  (defn between [open close p]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &open) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed _ c1)
            (match (~(Parser.run &p) src len &c1)
              (Reply.ErrEmpty e) (Reply.ErrConsumed e)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e)
              (Reply.OkConsumed v c2)
                (match (~(Parser.run &close) src len &c2)
                  (Reply.OkConsumed _ c3) (Reply.OkConsumed v c3)
                  (Reply.OkEmpty _ c3) (Reply.OkConsumed v c3)
                  (Reply.ErrEmpty e) (Reply.ErrConsumed e)
                  (Reply.ErrConsumed e) (Reply.ErrConsumed e))
              (Reply.OkEmpty v c2)
                (match (~(Parser.run &close) src len &c2)
                  (Reply.OkConsumed _ c3) (Reply.OkConsumed v c3)
                  (Reply.OkEmpty _ c3) (Reply.OkConsumed v c3)
                  (Reply.ErrEmpty e) (Reply.ErrConsumed e)
                  (Reply.ErrConsumed e) (Reply.ErrConsumed e)))
          (Reply.OkEmpty _ c1)
            (match (~(Parser.run &p) src len &c1)
              (Reply.ErrEmpty e) (Reply.ErrEmpty e)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e)
              (Reply.OkConsumed v c2)
                (match (~(Parser.run &close) src len &c2)
                  (Reply.OkConsumed _ c3) (Reply.OkConsumed v c3)
                  (Reply.OkEmpty _ c3) (Reply.OkConsumed v c3)
                  (Reply.ErrEmpty e) (Reply.ErrConsumed e)
                  (Reply.ErrConsumed e) (Reply.ErrConsumed e))
              (Reply.OkEmpty v c2)
                (match (~(Parser.run &close) src len &c2)
                  (Reply.OkConsumed _ c3) (Reply.OkConsumed v c3)
                  (Reply.OkEmpty _ c3) (Reply.OkEmpty v c3)
                  (Reply.ErrEmpty e) (Reply.ErrEmpty e)
                  (Reply.ErrConsumed e) (Reply.ErrConsumed e)))))))

  (private sep-by1-loop)
  (hidden sep-by1-loop)
  (defn sep-by1-loop [p sep src len start-cur acc start-consumed]
    (let-do [c start-cur
             values acc
             err (the (Maybe ParseErr) (Maybe.Nothing))
             consumed-any start-consumed
             going true]
      (while-do going
        (match (~(Parser.run sep) src len &c)
          (Reply.ErrEmpty _) (set! going false)
          (Reply.OkEmpty _ _) (set! going false)
          (Reply.ErrConsumed e2)
            (do
              (set! err (Maybe.Just e2))
              (set! consumed-any true)
              (set! going false))
          (Reply.OkConsumed _ c-after-sep)
            (do
              (set! consumed-any true)
              (match (~(Parser.run p) src len &c-after-sep)
                (Reply.OkConsumed v c2)
                  (do (set! values (Array.push-back values v)) (set! c c2))
                (Reply.OkEmpty v c2)
                  (do (set! values (Array.push-back values v)) (set! c c2))
                (Reply.ErrEmpty e2)
                  (do (set! err (Maybe.Just e2)) (set! going false))
                (Reply.ErrConsumed e2)
                  (do (set! err (Maybe.Just e2)) (set! going false))))))
      (match err
        (Maybe.Just e)
          (if consumed-any (Reply.ErrConsumed e) (Reply.ErrEmpty e))
        (Maybe.Nothing)
          (if consumed-any (Reply.OkConsumed values c) (Reply.OkEmpty values c)))))

  (doc sep-by1 "one or more `p` separated by `sep`. Trailing `sep`
is not allowed (`sep` must be followed by another `p`). Returns an
`Array` of `p` values.")
  (defn sep-by1 [p sep]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1) (sep-by1-loop &p &sep src len c1 [v1] true)
          (Reply.OkEmpty v1 c1) (sep-by1-loop &p &sep src len c1 [v1] false)))))

  (doc sep-by "zero or more `p` separated by `sep`. Returns an
`Array` (possibly empty).")
  (defn sep-by [p sep]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty _) (Reply.OkEmpty [] @cur)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1) (sep-by1-loop &p &sep src len c1 [v1] true)
          (Reply.OkEmpty v1 c1) (sep-by1-loop &p &sep src len c1 [v1] false)))))

  (private sep-end-by1-loop)
  (hidden sep-end-by1-loop)
  (defn sep-end-by1-loop [p sep src len start-cur acc start-consumed]
    (let-do [c start-cur
             values acc
             err (the (Maybe ParseErr) (Maybe.Nothing))
             consumed-any start-consumed
             going true]
      (while-do going
        (match (~(Parser.run sep) src len &c)
          (Reply.ErrEmpty _) (set! going false)
          (Reply.OkEmpty _ _) (set! going false)
          (Reply.ErrConsumed e2)
            (do
              (set! err (Maybe.Just e2))
              (set! consumed-any true)
              (set! going false))
          (Reply.OkConsumed _ c-after-sep)
            (do
              (set! consumed-any true)
              (match (~(Parser.run p) src len &c-after-sep)
                (Reply.OkConsumed v c2)
                  (do (set! values (Array.push-back values v)) (set! c c2))
                (Reply.OkEmpty v c2)
                  (do (set! values (Array.push-back values v)) (set! c c2))
                (Reply.ErrEmpty _) (do (set! c c-after-sep) (set! going false))
                (Reply.ErrConsumed e2)
                  (do (set! err (Maybe.Just e2)) (set! going false))))))
      (match err
        (Maybe.Just e)
          (if consumed-any (Reply.ErrConsumed e) (Reply.ErrEmpty e))
        (Maybe.Nothing)
          (if consumed-any (Reply.OkConsumed values c) (Reply.OkEmpty values c)))))

  (doc sep-end-by1 "one or more `p` separated by `sep`, with an
optional trailing `sep`. Returns an `Array` of `p` values. Like
`sep-by1` but allows the final element to be followed by `sep`.")
  (defn sep-end-by1 [p sep]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1)
            (sep-end-by1-loop &p &sep src len c1 [v1] true)
          (Reply.OkEmpty v1 c1) (sep-end-by1-loop &p &sep src len c1 [v1] false)))))

  (doc sep-end-by "zero or more `p` separated by `sep`, with an
optional trailing `sep`. Returns an `Array` (possibly empty). Like
`sep-by` but allows the final element to be followed by `sep`.")
  (defn sep-end-by [p sep]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty _) (Reply.OkEmpty [] @cur)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1)
            (sep-end-by1-loop &p &sep src len c1 [v1] true)
          (Reply.OkEmpty v1 c1) (sep-end-by1-loop &p &sep src len c1 [v1] false)))))

  (private end-by-loop)
  (hidden end-by-loop)
  (defn end-by-loop [p sep src len start-cur acc start-consumed]
    (let-do [c start-cur
             values acc
             err (the (Maybe ParseErr) (Maybe.Nothing))
             consumed-any start-consumed
             going true]
      (while-do going
        (match (~(Parser.run p) src len &c)
          (Reply.ErrEmpty _) (set! going false)
          (Reply.ErrConsumed e2)
            (do
              (set! err (Maybe.Just e2))
              (set! consumed-any true)
              (set! going false))
          (Reply.OkConsumed v c-after-p)
            (do
              (set! consumed-any true)
              (match (~(Parser.run sep) src len &c-after-p)
                (Reply.OkConsumed _ c3)
                  (do (set! values (Array.push-back values v)) (set! c c3))
                (Reply.OkEmpty _ c3)
                  (do (set! values (Array.push-back values v)) (set! c c3))
                (Reply.ErrEmpty e2)
                  (do (set! err (Maybe.Just e2)) (set! going false))
                (Reply.ErrConsumed e2)
                  (do (set! err (Maybe.Just e2)) (set! going false))))
          (Reply.OkEmpty v c-after-p)
            (match (~(Parser.run sep) src len &c-after-p)
              (Reply.OkConsumed _ c3)
                (do
                  (set! values (Array.push-back values v))
                  (set! c c3)
                  (set! consumed-any true))
              (Reply.OkEmpty _ _) (set! going false)
              (Reply.ErrEmpty e2)
                (do (set! err (Maybe.Just e2)) (set! going false))
              (Reply.ErrConsumed e2)
                (do
                  (set! err (Maybe.Just e2))
                  (set! consumed-any true)
                  (set! going false)))))
      (match err
        (Maybe.Just e)
          (if consumed-any (Reply.ErrConsumed e) (Reply.ErrEmpty e))
        (Maybe.Nothing)
          (if consumed-any (Reply.OkConsumed values c) (Reply.OkEmpty values c)))))

  (doc end-by1 "one or more `p` each followed by `sep`. Unlike
`sep-by1`, the separator acts as a **terminator** — the last `p` must
also be followed by `sep`. Returns an `Array` of `p` values.")
  (defn end-by1 [p sep]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1)
            (match (~(Parser.run &sep) src len &c1)
              (Reply.OkConsumed _ c2) (end-by-loop &p &sep src len c2 [v1] true)
              (Reply.OkEmpty _ c2) (end-by-loop &p &sep src len c2 [v1] true)
              (Reply.ErrEmpty e) (Reply.ErrConsumed e)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e))
          (Reply.OkEmpty v1 c1)
            (match (~(Parser.run &sep) src len &c1)
              (Reply.OkConsumed _ c2) (end-by-loop &p &sep src len c2 [v1] true)
              (Reply.OkEmpty _ c2) (end-by-loop &p &sep src len c2 [v1] false)
              (Reply.ErrEmpty e) (Reply.ErrEmpty e)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e))))))

  (doc end-by "zero or more `p` each followed by `sep`. Returns an
`Array` (possibly empty). Each element must be terminated by `sep`.")
  (defn end-by [p sep]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty _) (Reply.OkEmpty [] @cur)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1)
            (match (~(Parser.run &sep) src len &c1)
              (Reply.OkConsumed _ c2) (end-by-loop &p &sep src len c2 [v1] true)
              (Reply.OkEmpty _ c2) (end-by-loop &p &sep src len c2 [v1] true)
              (Reply.ErrEmpty e) (Reply.ErrConsumed e)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e))
          (Reply.OkEmpty v1 c1)
            (match (~(Parser.run &sep) src len &c1)
              (Reply.OkConsumed _ c2) (end-by-loop &p &sep src len c2 [v1] true)
              (Reply.OkEmpty _ c2) (end-by-loop &p &sep src len c2 [v1] false)
              (Reply.ErrEmpty e) (Reply.ErrEmpty e)
              (Reply.ErrConsumed e) (Reply.ErrConsumed e))))))

  (doc choice "tries each parser in turn; returns the first
success. If all parsers fail empty, the resulting failure merges
their expected sets. A consumed failure of any parser short-circuits
(use `try` inside if needed).")
  (defn choice [ps]
    (Parser.init
      (fn [src len cur]
        (let-do [n (Array.length &ps)
                 i 0
                 going true
                 result (the (Reply a) (Reply.ErrEmpty (ParseErr.empty-at cur)))
                 labels []
                 err-pos @(Cursor.pos cur)
                 err-line @(Cursor.line cur)
                 err-col @(Cursor.col cur)
                 err-unx (the (Maybe String) (Maybe.Nothing))]
          (while-do (and going (Int.< i n))
            (match (~(Parser.run (Array.unsafe-nth &ps i)) src len cur)
              (Reply.OkConsumed v c)
                (do (set! result (Reply.OkConsumed v c)) (set! going false))
              (Reply.OkEmpty v c)
                (do (set! result (Reply.OkEmpty v c)) (set! going false))
              (Reply.ErrConsumed e)
                (do (set! result (Reply.ErrConsumed e)) (set! going false))
              (Reply.ErrEmpty e)
                (do
                  (set! err-pos @(ParseErr.pos &e))
                  (set! err-line @(ParseErr.line &e))
                  (set! err-col @(ParseErr.col &e))
                  (match @(ParseErr.unexpected &e)
                    (Maybe.Just s) (set! err-unx (Maybe.Just s))
                    (Maybe.Nothing) ())
                  (set! labels
                        (Expected.append-into labels (ParseErr.expected &e)))))
            (set! i (Int.inc i)))
          (if going
            (Reply.ErrEmpty
              (ParseErr.init err-pos
                             err-line
                             err-col
                             err-unx
                             (Expected.Many labels)))
            result)))))

  (private chainl1-loop)
  (hidden chainl1-loop)
  (defn chainl1-loop [p op src len start-cur start-val start-consumed]
    (let-do [c start-cur
             acc start-val
             err (the (Maybe ParseErr) (Maybe.Nothing))
             consumed-any start-consumed
             going true]
      (while-do going
        (match (~(Parser.run op) src len &c)
          (Reply.ErrEmpty _) (set! going false)
          (Reply.OkEmpty _ _) (set! going false)
          (Reply.ErrConsumed e2)
            (do
              (set! err (Maybe.Just e2))
              (set! consumed-any true)
              (set! going false))
          (Reply.OkConsumed f c-after-op)
            (do
              (set! consumed-any true)
              (match (~(Parser.run p) src len &c-after-op)
                (Reply.OkConsumed v c2) (do (set! acc (f acc v)) (set! c c2))
                (Reply.OkEmpty v c2) (do (set! acc (f acc v)) (set! c c2))
                (Reply.ErrEmpty e2)
                  (do (set! err (Maybe.Just e2)) (set! going false))
                (Reply.ErrConsumed e2)
                  (do (set! err (Maybe.Just e2)) (set! going false))))))
      (match err
        (Maybe.Just e)
          (if consumed-any (Reply.ErrConsumed e) (Reply.ErrEmpty e))
        (Maybe.Nothing)
          (if consumed-any (Reply.OkConsumed acc c) (Reply.OkEmpty acc c)))))

  (doc chainl1 "parses one or more occurrences of `p` separated by
`op`. `op` returns a binary function used to combine values
left-associatively. Example: `(chainl1 (Lexer.integer) add-op)`
parses `1+2+3` as `((1+2)+3)`.")
  (defn chainl1 [p op]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1) (chainl1-loop &p &op src len c1 v1 true)
          (Reply.OkEmpty v1 c1) (chainl1-loop &p &op src len c1 v1 false)))))

  (doc chainl "like `chainl1` but returns `default` if `p` fails on
the first attempt.")
  (defn chainl [p op default]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty _) (Reply.OkEmpty @&default @cur)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1) (chainl1-loop &p &op src len c1 v1 true)
          (Reply.OkEmpty v1 c1) (chainl1-loop &p &op src len c1 v1 false)))))

  (private chainr1-loop)
  (hidden chainr1-loop)
  ; Like chainl1-loop but collects values and operators into arrays,
  ; then right-folds at the end. consumed-any is included for
  ; structural consistency with chainl1-loop; in practice it is always
  ; true because the first p already consumed input before entering
  ; the loop.
  (defn chainr1-loop [p op src len start-cur start-val start-consumed]
    (let-do [vals [start-val]
             ops []
             c start-cur
             err (the (Maybe ParseErr) (Maybe.Nothing))
             consumed-any start-consumed
             going true]
      (while-do going
        (match (~(Parser.run op) src len &c)
          (Reply.ErrEmpty _) (set! going false)
          (Reply.OkEmpty _ _) (set! going false)
          (Reply.ErrConsumed e2)
            (do
              (set! err (Maybe.Just e2))
              (set! consumed-any true)
              (set! going false))
          (Reply.OkConsumed f c-after-op)
            (do
              (set! consumed-any true)
              (match (~(Parser.run p) src len &c-after-op)
                (Reply.OkConsumed v c2)
                  (do
                    (set! ops (Array.push-back ops f))
                    (set! vals (Array.push-back vals v))
                    (set! c c2))
                (Reply.OkEmpty v c2)
                  (do
                    (set! ops (Array.push-back ops f))
                    (set! vals (Array.push-back vals v))
                    (set! c c2))
                (Reply.ErrEmpty e2)
                  (do (set! err (Maybe.Just e2)) (set! going false))
                (Reply.ErrConsumed e2)
                  (do (set! err (Maybe.Just e2)) (set! going false))))))
      (match err
        (Maybe.Just e)
        (if consumed-any (Reply.ErrConsumed e) (Reply.ErrEmpty e))
        (Maybe.Nothing)
        ; Right-fold: apply ops from right to left
        (let-do [n (Array.length &vals)
                 acc @(Array.unsafe-nth &vals (Int.dec n))
                 i (Int.- n 2)]
          (while-do (Int.>= i 0)
            (let [f @(Array.unsafe-nth &ops i)
                  v @(Array.unsafe-nth &vals i)]
              (set! acc (f v acc)))
            (set! i (Int.dec i)))
          (if consumed-any (Reply.OkConsumed acc c) (Reply.OkEmpty acc c))))))

  (doc chainr1 "parses one or more occurrences of `p` separated by
`op`. `op` returns a binary function used to combine values
right-associatively. Example: with exponentiation as `op`,
`2^3^2` parses as `2^(3^2) = 512`.")
  (defn chainr1 [p op]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty e) (Reply.ErrEmpty e)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1) (chainr1-loop &p &op src len c1 v1 true)
          (Reply.OkEmpty v1 c1) (chainr1-loop &p &op src len c1 v1 false)))))

  (doc chainr "like `chainr1` but returns `default` if `p` fails on
the first attempt.")
  (defn chainr [p op default]
    (Parser.init
      (fn [src len cur]
        (match (~(Parser.run &p) src len cur)
          (Reply.ErrEmpty _) (Reply.OkEmpty @&default @cur)
          (Reply.ErrConsumed e) (Reply.ErrConsumed e)
          (Reply.OkConsumed v1 c1) (chainr1-loop &p &op src len c1 v1 true)
          (Reply.OkEmpty v1 c1) (chainr1-loop &p &op src len c1 v1 false)))))

  (doc slice-of "runs `p`; on success, replaces `p`'s value with
the slice of input that `p` consumed (as a `String`). On failure,
propagates as-is.")
  (defn slice-of [p]
    (Parser.init
      (fn [src len cur]
        (let [start @(Cursor.pos cur)]
          (match (~(Parser.run &p) src len cur)
            (Reply.OkConsumed _ c)
              (Reply.OkConsumed (String.byte-slice src start @(Cursor.pos &c)) c)
            (Reply.OkEmpty _ c)
              (Reply.OkEmpty (String.byte-slice src start @(Cursor.pos &c)) c)
            (Reply.ErrConsumed e) (Reply.ErrConsumed e)
            (Reply.ErrEmpty e) (Reply.ErrEmpty e))))))

  (doc take "consumes exactly `n` bytes, returning them as a
`String`. Fails empty if fewer than `n` bytes remain.")
  (defn take [n]
    (Parser.init
      (fn [src len cur]
        (let [start @(Cursor.pos cur)]
          (if (Int.> (Int.+ start n) len)
            (Reply.ErrEmpty (ParseErr.expected-at cur (fmt "%d more bytes" n)))
            (let-do [c @cur]
              (for [i 0 n]
                (set! c (Cursor.advance &c (String.char-at src (Int.+ start i)))))
              (if (Int.> n 0)
                (Reply.OkConsumed
                  (String.byte-slice src start (Int.+ start n))
                  c)
                (Reply.OkEmpty (String.byte-slice src start (Int.+ start n)) c))))))))

  (doc take-while "consumes bytes while `pred` holds. Always
succeeds (possibly with empty result). Returns the consumed slice as
a `String`.")
  (defn take-while [pred]
    (Parser.init
      (fn [src len cur]
        (let-do [start @(Cursor.pos cur)
                 c @cur
                 going true]
          (while-do (and going (Int.< @(Cursor.pos &c) len))
            (let [b (String.char-at src @(Cursor.pos &c))]
              (if (pred b) (set! c (Cursor.advance &c b)) (set! going false))))
          (let [end @(Cursor.pos &c)]
            (if (Int.> end start)
              (Reply.OkConsumed (String.byte-slice src start end) c)
              (Reply.OkEmpty (String.byte-slice src start end) c)))))))

  (doc take-while1 "like `take-while`, but requires at least one byte to match.")
  (defn take-while1 [pred]
    (Parser.init
      (fn [src len cur]
        (let-do [start @(Cursor.pos cur)
                 c @cur
                 going true]
          (while-do (and going (Int.< @(Cursor.pos &c) len))
            (let [b (String.char-at src @(Cursor.pos &c))]
              (if (pred b) (set! c (Cursor.advance &c b)) (set! going false))))
          (let [end @(Cursor.pos &c)]
            (if (Int.> end start)
              (Reply.OkConsumed (String.byte-slice src start end) c)
              (Reply.ErrEmpty
                (ParseErr.expected-at cur @"at least one matching byte"))))))))

  (doc UTF8 "is a submodule of codepoint-level parsers layered on the
byte-level core. Each codepoint advances the cursor by one column,
regardless of byte width.")
  (defmodule UTF8
    (private decode)
    (hidden decode)
    (doc decode "decodes one UTF-8 codepoint at byte position `pos` in
`src`. Returns `(Maybe (Pair Char Int))` where the `Int` is the byte
width (1-4) of the codepoint, or `Nothing` on EOF or malformed input.")
    (private byte-at)
    (hidden byte-at)
    (defn byte-at [src pos]
      (Int.bit-and 255 (Char.to-int (String.char-at src pos))))

    (defn decode [src len pos]
      (if (Int.>= pos len)
        (Maybe.Nothing)
        (let [b0 (byte-at src pos)]
          (cond
            (Int.< b0 128) (Maybe.Just (Pair.init (Char.from-int b0) 1))
            (Int.< b0 192) (Maybe.Nothing)
            (Int.< b0 224)
              (if (Int.>= (Int.+ pos 1) len)
                (Maybe.Nothing)
                (let [b1 (byte-at src (Int.+ pos 1))
                      cp (Int.bit-or
                        (Int.bit-shift-left (Int.bit-and b0 31) 6)
                        (Int.bit-and b1 63))]
                  (Maybe.Just (Pair.init (Char.from-int cp) 2))))
            (Int.< b0 240)
              (if (Int.>= (Int.+ pos 2) len)
                (Maybe.Nothing)
                (let [b1 (byte-at src (Int.+ pos 1))
                      b2 (byte-at src (Int.+ pos 2))
                      cp (Int.bit-or
                        (Int.bit-or
                          (Int.bit-shift-left (Int.bit-and b0 15) 12)
                          (Int.bit-shift-left (Int.bit-and b1 63) 6))
                        (Int.bit-and b2 63))]
                  (Maybe.Just (Pair.init (Char.from-int cp) 3))))
            (Int.< b0 248)
              (if (Int.>= (Int.+ pos 3) len)
                (Maybe.Nothing)
                (let [b1 (byte-at src (Int.+ pos 1))
                      b2 (byte-at src (Int.+ pos 2))
                      b3 (byte-at src (Int.+ pos 3))
                      cp (Int.bit-or
                        (Int.bit-or
                          (Int.bit-or
                            (Int.bit-shift-left (Int.bit-and b0 7) 18)
                            (Int.bit-shift-left (Int.bit-and b1 63) 12))
                          (Int.bit-shift-left (Int.bit-and b2 63) 6))
                        (Int.bit-and b3 63))]
                  (Maybe.Just (Pair.init (Char.from-int cp) 4))))
            (Maybe.Nothing)))))

    (doc any-char "consumes one UTF-8 codepoint, returning it as a
`Char`. Fails empty at end of input or on malformed UTF-8.")
    (defn any-char []
      (Parser.init
        (fn [src len cur]
          (let [pos @(Cursor.pos cur)]
            (match (decode src len pos)
              (Maybe.Nothing)
                (Reply.ErrEmpty (ParseErr.expected-at cur @"any character"))
              (Maybe.Just dec)
                (let [cp @(Pair.a &dec)
                      w @(Pair.b &dec)]
                  (Reply.OkConsumed cp
                                    (Cursor.advance-by cur
                                                       w
                                                       (Char.= cp \newline)))))))))

    (doc char "consumes a specific Unicode codepoint. Fails empty if the
input doesn't match.")
    (defn char [c]
      (Parser.init
        (fn [src len cur]
          (let [pos @(Cursor.pos cur)]
            (match (decode src len pos)
              (Maybe.Nothing)
                (Reply.ErrEmpty
                  (ParseErr.expected-at cur (fmt "U+%04x" (Char.to-int c))))
              (Maybe.Just dec)
                (let [cp @(Pair.a &dec)
                      w @(Pair.b &dec)]
                  (if (Char.= cp c)
                    (Reply.OkConsumed cp
                                      (Cursor.advance-by cur
                                                         w
                                                         (Char.= cp \newline)))
                    (Reply.ErrEmpty
                      (ParseErr.expected-at cur (fmt "U+%04x" (Char.to-int c)))))))))))

    (doc codepoint-satisfy "consumes one UTF-8 codepoint if `pred` holds.
Fails empty otherwise (or at EOF / on malformed input).")
    (defn codepoint-satisfy [pred lbl]
      (Parser.init
        (fn [src len cur]
          (let [pos @(Cursor.pos cur)]
            (match (decode src len pos)
              (Maybe.Nothing) (Reply.ErrEmpty (ParseErr.expected-at cur @&lbl))
              (Maybe.Just dec)
                (let [cp @(Pair.a &dec)
                      w @(Pair.b &dec)]
                  (if (pred cp)
                    (Reply.OkConsumed cp
                                      (Cursor.advance-by cur
                                                         w
                                                         (Char.= cp \newline)))
                    (Reply.ErrEmpty (ParseErr.expected-at cur @&lbl))))))))))

  (doc Lexer "is a submodule of common-token parsers: whitespace
handling, integers, identifiers, and literal symbols.")
  (defmodule Lexer
    (private digit?)
    (hidden digit?)
    (defn digit? [c] (and (Char.>= c \0) (Char.<= c \9)))

    (private alpha?)
    (hidden alpha?)
    (defn alpha? [c]
      (or (and (Char.>= c \A) (Char.<= c \Z))
          (and (Char.>= c \a) (Char.<= c \z))))

    (private alnum?)
    (hidden alnum?)
    (defn alnum? [c] (or (alpha? c) (digit? c)))

    (private scan-digits)
    (hidden scan-digits)
    (doc scan-digits "advances through ASCII digits starting at
`start-c`. Returns the cursor after the last digit (which equals
`start-c` if there were none).")
    (defn scan-digits [src len start-c]
      (let-do [c @start-c]
        (while-do (and (Int.< @(Cursor.pos &c) len)
                       (let [ch (String.char-at src @(Cursor.pos &c))]
                         (and (Char.>= ch \0) (Char.<= ch \9))))
          (set! c (Cursor.advance &c (String.char-at src @(Cursor.pos &c)))))
        c))

    (private int-overflow?)
    (hidden int-overflow?)
    (defn int-overflow? [s n]
      (if (Int.<= (String.length s) 1)
        false
        (let-do [i 0
                 slen (String.length s)]
          (while-do (and (Int.< i (Int.- slen 1))
                         (Char.= (String.char-at s i) \0))
            (set! i (Int.+ i 1)))
          (not (String.= &(Int.str n) &(String.byte-slice s i slen))))))

    (private space?)
    (hidden space?)
    (defn space? [c]
      (or (or (Char.= c \space) (Char.= c \tab))
          (or (Char.= c \newline) (Char.= c \return))))

    (doc whitespace "consumes zero or more ASCII whitespace bytes (space,
tab, CR, LF). Always succeeds; the result is unit.")
    (defn whitespace []
      (Parser.map (Parser.take-while (fn [c] (space? c))) (fn [_] ())))

    (doc lexeme "runs `p`, then skips trailing whitespace. Returns `p`'s value.")
    (defn lexeme [p] (Parser.before p (whitespace)))

    (doc symbol
      "matches the literal string `s`, then skips trailing whitespace.")
    (defn symbol [s] (lexeme (Parser.string s)))

    (doc unsigned-int "parses one or more decimal digits as an
`Int`. Fused into a single closure for performance — does not go
through `bind`/`map`.")
    (defn unsigned-int []
      (Parser.init
        (fn [src len cur]
          (let [start @(Cursor.pos cur)
                c (scan-digits src len cur)]
            (if (Int.> @(Cursor.pos &c) start)
              (let [s (String.byte-slice src start @(Cursor.pos &c))]
                (match (Int.from-string &s)
                  (Maybe.Just n)
                    (if (int-overflow? &s n)
                      (Reply.ErrConsumed (ParseErr.expected-at &c @"integer"))
                      (Reply.OkConsumed n c))
                  (Maybe.Nothing)
                    (Reply.ErrConsumed (ParseErr.expected-at &c @"integer"))))
              (Reply.ErrEmpty (ParseErr.expected-at cur @"integer")))))))

    (doc integer "parses an optional `-` sign followed by decimal
digits as an `Int`. Fused into a single closure.")
    (defn integer []
      (Parser.init
        (fn [src len cur]
          (let-do [c @cur
                   negate? false]
            (when-do (and (Int.< @(Cursor.pos &c) len)
                          (Char.= (String.char-at src @(Cursor.pos &c)) \-))
              (set! c (Cursor.advance &c \-))
              (set! negate? true))
            (let [digit-start @(Cursor.pos &c)
                  c2 (scan-digits src len &c)]
              (if (Int.> @(Cursor.pos &c2) digit-start)
                (let [s (String.byte-slice src digit-start @(Cursor.pos &c2))]
                  (match (Int.from-string &s)
                    (Maybe.Just n)
                      (if (int-overflow? &s n)
                        (Reply.ErrConsumed (ParseErr.expected-at &c2 @"integer"))
                        (Reply.OkConsumed (if negate? (Int.neg n) n) c2))
                    (Maybe.Nothing)
                      (Reply.ErrConsumed (ParseErr.expected-at &c2 @"integer"))))
                ; Sign consumed but no digits: consumed-failure.
                (if negate?
                  (Reply.ErrConsumed (ParseErr.expected-at &c2 @"integer"))
                  (Reply.ErrEmpty (ParseErr.expected-at cur @"integer")))))))))

    (doc identifier "parses a C-style identifier: a letter or
underscore, followed by zero or more letters, digits, or underscores.
Returns the matched text as a `String`.")
    (defn identifier []
      (Parser.slice-of
        (Parser.seq
          (Parser.satisfy (fn [c] (or (alpha? c) (Char.= c \_)))
                          @"identifier start")
          (Parser.take-while (fn [c] (or (alnum? c) (Char.= c \_)))))))

    (doc float "parses a floating-point number and returns a `Double`.
Handles optional leading `-`, integer part, decimal point with
fractional digits, and optional exponent (`e`/`E` with optional
sign). At least one digit must appear in the integer or fractional
part. Uses `slice-of` and `Double.from-string` for conversion.")
    (defn float []
      (Parser.bind-result
        (Parser.slice-of
          (Parser.init
            (fn [src len cur]
              (let-do [c @cur
                       consumed false]
                ; optional minus
                (when-do (and (Int.< @(Cursor.pos &c) len)
                              (Char.= (String.char-at src @(Cursor.pos &c)) \-))
                  (set! c (Cursor.advance &c \-))
                  (set! consumed true))
                ; integer part (digits before dot)
                (let-do [before-int @(Cursor.pos &c)
                         c2 (scan-digits src len &c)
                         has-int (Int.> @(Cursor.pos &c2) before-int)]
                  (when-do has-int (set! c c2) (set! consumed true))
                  ; optional fractional part: '.' digits
                  (let-do [has-frac false]
                    (when-do (and (Int.< @(Cursor.pos &c) len)
                                  (Char.= (String.char-at src @(Cursor.pos &c))
                                          \.))
                      (let-do [c-dot (Cursor.advance &c \.)
                               c3 (scan-digits src len &c-dot)]
                        (when-do (Int.> @(Cursor.pos &c3) @(Cursor.pos &c-dot))
                          (set! c c3)
                          (set! consumed true)
                          (set! has-frac true))))
                    (if (not (or has-int has-frac))
                      ; no digits at all
                      (if consumed
                        (Reply.ErrConsumed (ParseErr.expected-at &c @"float"))
                        (Reply.ErrEmpty (ParseErr.expected-at cur @"float")))
                      (do
                        ; optional exponent: [eE][+-]?digits
                        (when-do (and (Int.< @(Cursor.pos &c) len)
                                      (let [ch (String.char-at src
                                                               @(Cursor.pos &c))]
                                        (or (Char.= ch \e) (Char.= ch \E))))
                          (let-do [c-e (Cursor.advance &c
                                                       (String.char-at src
                                                                       @(Cursor.pos &c)))]
                            ; optional sign
                            (when-do (and (Int.< @(Cursor.pos &c-e) len)
                                          (let [ch (String.char-at src
                                                                   @(Cursor.pos &c-e))]
                                            (or (Char.= ch \+) (Char.= ch \-))))
                              (set! c-e
                                    (Cursor.advance &c-e
                                                    (String.char-at src
                                                                    @(Cursor.pos &c-e)))))
                            (let [c4 (scan-digits src len &c-e)]
                              (when (Int.> @(Cursor.pos &c4) @(Cursor.pos &c-e))
                                (set! c c4)))))
                        (if consumed
                          (Reply.OkConsumed () c)
                          (Reply.OkEmpty () c))))))))))
        (fn [s cur]
          (the (Result Double ParseErr)
               (match (Double.from-string &s)
                 (Maybe.Just d) (Result.Success d)
                 (Maybe.Nothing)
                   (Result.Error (ParseErr.expected-at cur @"float"))))))))

  (doc format-error "renders a `ParseErr` as a human-readable
`String`. Format: `parse error at LINE:COL: unexpected X; expected: Y, Z, W`.
Uses `StringBuf` internally.")
  (defn format-error [e]
    (let-do [sb (StringBuf.create)]
      (StringBuf.append-str &sb "parse error at ")
      (StringBuf.append-int &sb @(ParseErr.line e))
      (StringBuf.append-char &sb \:)
      (StringBuf.append-int &sb @(ParseErr.col e))
      (match-ref (ParseErr.unexpected e)
        (Maybe.Just s)
          (do
            (StringBuf.append-str &sb ": unexpected ")
            (StringBuf.append-str &sb s))
        (Maybe.Nothing) ())
      (match-ref (ParseErr.expected e)
        (Expected.One s)
          (do
            (StringBuf.append-str &sb "; expected: ")
            (StringBuf.append-str &sb s))
        (Expected.Many a)
          (let [n (Array.length a)]
            (when-do (Int.> n 0)
              (StringBuf.append-str &sb "; expected: ")
              (for [i 0 n]
                (do
                  (when (Int.> i 0) (StringBuf.append-str &sb ", "))
                  (StringBuf.append-str &sb (Array.unsafe-nth a i)))))))
      (let-do [s (StringBuf.to-string &sb)] (StringBuf.delete sb) s)))

  (doc parse "runs `p` over the entire input. Strict: fails if `p`
doesn't consume all of `src`. Returns `(Result a ParseErr)`.")
  (defn parse [p src]
    (let [len (String.length src)
          cur (Cursor.zero)]
      (match (~(Parser.run &p) src len &cur)
        (Reply.ErrConsumed e) (Result.Error e)
        (Reply.ErrEmpty e) (Result.Error e)
        (Reply.OkConsumed v c)
          (if (Int.>= @(Cursor.pos &c) len)
            (Result.Success v)
            (Result.Error (ParseErr.expected-at &c @"end of input")))
        (Reply.OkEmpty v c)
          (if (Int.>= @(Cursor.pos &c) len)
            (Result.Success v)
            (Result.Error (ParseErr.expected-at &c @"end of input"))))))

  (doc parse-partial "runs `p` on the input without requiring it to
consume everything. On success, returns a `Pair` of the parsed value
and the remaining unconsumed input as a `String`. On error, returns
the `ParseErr`.")
  (defn parse-partial [p src]
    (let [len (String.length src)
          cur (Cursor.zero)]
      (match (~(Parser.run &p) src len &cur)
        (Reply.ErrConsumed e) (Result.Error e)
        (Reply.ErrEmpty e) (Result.Error e)
        (Reply.OkConsumed v c)
          (Result.Success
            (Pair.init v (String.byte-slice src @(Cursor.pos &c) len)))
        (Reply.OkEmpty v c)
          (Result.Success
            (Pair.init v (String.byte-slice src @(Cursor.pos &c) len)))))))

(defmodule Parser
  (doc string-ci "matches the literal string `s` case-insensitively
(ASCII only). Returns the matched slice from the input, preserving
its original case. Atomic: on partial mismatch, fails empty.")
  (defn string-ci [s]
    (let [lbl (fmt "\"%s\" (case-insensitive)" &s)]
      (string-match s
                    lbl
                    (fn [a b]
                      (let [al (if (and (Char.>= a \A) (Char.<= a \Z))
                              (Char.from-int (Int.+ (Char.to-int a) 32))
                              a)
                            bl (if (and (Char.>= b \A) (Char.<= b \Z))
                              (Char.from-int (Int.+ (Char.to-int b) 32))
                              b)]
                        (Char.= al bl))))))

  (doc range "runs `p` between `lo` and `hi` times (inclusive),
collecting results into an `Array`. The first `lo` applications are
mandatory; after that, `p` is applied greedily up to `hi` times
total, stopping on empty failure or empty success (same guard as
`many`).")
  (defn range [lo hi p]
    (Parser.init
      (fn [src len cur]
        (let-do [acc []
                 c @cur
                 err (the (Maybe ParseErr) (Maybe.Nothing))
                 consumed-any false
                 i 0
                 going true]
          ; Phase 1: mandatory (first lo iterations)
          (while-do (and going (Int.< i lo))
            (match (~(Parser.run &p) src len &c)
              (Reply.OkConsumed v c2)
                (do
                  (set! acc (Array.push-back acc v))
                  (set! c c2)
                  (set! consumed-any true))
              (Reply.OkEmpty v c2)
                (do (set! acc (Array.push-back acc v)) (set! c c2))
              (Reply.ErrEmpty e)
                (do (set! err (Maybe.Just e)) (set! going false))
              (Reply.ErrConsumed e)
                (do (set! err (Maybe.Just e)) (set! going false)))
            (set! i (Int.inc i)))
          ; Phase 2: optional (up to hi - lo more)
          (while-do (and going (Int.< i hi))
            (match (~(Parser.run &p) src len &c)
              (Reply.OkConsumed v c2)
                (do
                  (set! acc (Array.push-back acc v))
                  (set! c c2)
                  (set! consumed-any true))
              (Reply.OkEmpty _ _) (set! going false)
              (Reply.ErrEmpty _) (set! going false)
              (Reply.ErrConsumed e)
                (do (set! err (Maybe.Just e)) (set! going false)))
            (set! i (Int.inc i)))
          (match err
            (Maybe.Just e)
              (if consumed-any (Reply.ErrConsumed e) (Reply.ErrEmpty e))
            (Maybe.Nothing)
              (if consumed-any (Reply.OkConsumed acc c) (Reply.OkEmpty acc c)))))))

  (defmodule Lexer
    (doc line-comment "skips a line comment: matches the literal prefix
`prefix`, then consumes all bytes until end of line or end of input.
The newline itself is not consumed. Returns unit.")
    (defn line-comment [prefix]
      (Parser.then (Parser.string prefix)
                   (Parser.map
                     (Parser.take-while (fn [c] (not (Char.= c \newline))))
                     (fn [_] ()))))

    (doc block-comment "skips a block comment delimited by `open` and
`close`, with nesting support. An `open` inside the comment
increments the depth, and each `close` decrements it. The comment
ends when depth reaches zero. Fails (consumed) if EOF is reached
before the comment closes. Returns unit.")
    (defn block-comment [open close]
      (let [olen (String.length &open)
            clen (String.length &close)
            lbl (fmt "\"%s\"" &open)]
        (Parser.init
          (fn [src len cur]
            (let [pos @(Cursor.pos cur)]
              (if (Int.> (Int.+ pos olen) len)
                (Reply.ErrEmpty (ParseErr.expected-at cur @&lbl))
                (let-do [matches true]
                  (for [i 0 olen]
                    (unless (Char.= (String.char-at &open i)
                                    (String.char-at src (Int.+ pos i)))
                      (set! matches false)))
                  (if (not matches)
                    (Reply.ErrEmpty (ParseErr.expected-at cur @&lbl))
                    (let-do [c @cur]
                      (for [i 0 olen]
                        (set! c
                              (Cursor.advance &c
                                              (String.char-at src (Int.+ pos i)))))
                      (let-do [depth 1
                               going true
                               err false]
                        (while-do going
                          (let [p @(Cursor.pos &c)]
                            (if (Int.>= p len)
                              (do (set! going false) (set! err true))
                              (let-do [is-close false]
                                (when-do (Int.<= (Int.+ p clen) len)
                                  (let-do [m true]
                                    (for [i 0 clen]
                                      (unless (Char.= (String.char-at &close i)
                                                      (String.char-at src
                                                                      (Int.+ p i)))
                                        (set! m false)))
                                    (set! is-close m)))
                                (if is-close
                                  (do
                                    (set! depth (Int.dec depth))
                                    (for [i 0 clen]
                                      (set! c
                                            (Cursor.advance &c
                                                            (String.char-at src
                                                                            (Int.+ p
                                                                                   i)))))
                                    (when (= depth 0) (set! going false)))
                                  (let-do [is-open false]
                                    (when-do (Int.<= (Int.+ p olen) len)
                                      (let-do [m true]
                                        (for [i 0 olen]
                                          (unless (Char.= (String.char-at &open
                                                                          i)
                                                          (String.char-at src
                                                                          (Int.+ p
                                                                                 i)))
                                            (set! m false)))
                                        (set! is-open m)))
                                    (if is-open
                                      (do
                                        (set! depth (Int.inc depth))
                                        (for [i 0 olen]
                                          (set! c
                                                (Cursor.advance &c
                                                                (String.char-at src
                                                                                (Int.+ p
                                                                                       i))))))
                                      (set! c
                                            (Cursor.advance &c
                                                            (String.char-at src
                                                                            p))))))))))
                        (if err
                          (Reply.ErrConsumed
                            (ParseErr.expected-at &c @"end of block comment"))
                          (Reply.OkConsumed () c))))))))))))))

(defmodule Parser
  (defmodule Lexer
    (doc digit "matches one ASCII digit (`0`-`9`). Returns the byte.")
    (defn digit [] (Parser.satisfy (fn [c] (digit? c)) @"digit"))

    (doc letter "matches one ASCII letter (`a`-`z`, `A`-`Z`). Returns
the byte.")
    (defn letter [] (Parser.satisfy (fn [c] (alpha? c)) @"letter"))

    (doc upper "matches one ASCII uppercase letter (`A`-`Z`). Returns
the byte.")
    (defn upper []
      (Parser.satisfy
        (fn [c] (and (Char.>= c \A) (Char.<= c \Z)))
        @"uppercase letter"))

    (doc lower "matches one ASCII lowercase letter (`a`-`z`). Returns
the byte.")
    (defn lower []
      (Parser.satisfy
        (fn [c] (and (Char.>= c \a) (Char.<= c \z)))
        @"lowercase letter"))

    (doc alpha-num "matches one ASCII letter or digit. Returns the
byte.")
    (defn alpha-num [] (Parser.satisfy (fn [c] (alnum? c)) @"letter or digit"))

    (doc space "matches one ASCII whitespace byte (space, tab, CR,
LF). Returns the byte.")
    (defn space [] (Parser.satisfy (fn [c] (space? c)) @"space"))))
