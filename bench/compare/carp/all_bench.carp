; Mirror of the Haskell head-to-head benches.
; Inputs and grammars match haskell/src/Main.hs byte-for-byte.

(load "../../../parsec.carp")
(Project.no-echo)
(load "Bench.carp")
(use-all Bench IO)

; ============================================================
; Inputs
; ============================================================

(def *kv100*    @"")
(def *kv1000*   @"")
(def *ints100*  @"")
(def *ints1k*   @"")
(def *deep100*  @"")
(def *flat1k*   @"")

(defn build-kv [n]
  (let-do [parts (the (Array String) [])]
    (for [i 0 n]
      (Array.push-back! &parts (fmt "k%d=%d" i i)))
    (String.join "; " &parts)))

(defn build-int-list [n]
  (let-do [parts (the (Array String) [])]
    (for [i 0 n]
      (Array.push-back! &parts (Int.str i)))
    (String.join "," &parts)))

(defn build-rep [n s]
  (let-do [parts (the (Array String) [])]
    (for [i 0 n]
      (Array.push-back! &parts @s))
    (String.concat &parts)))

(defn build-deep-sexp [n]
  (let-do [opens  (build-rep n "(")
           closes (build-rep n ")")]
    (String.append &(String.append &opens "x") &closes)))

(defn build-flat-sexp [n]
  (let-do [parts (the (Array String) []) ]
    (for [i 0 n] (Array.push-back! &parts @"x"))
    (fmt "(%s)" &(String.join " " &parts))))

(defn setup []
  (do
    (set! *kv100*   (build-kv 100))
    (set! *kv1000*  (build-kv 1000))
    (set! *ints100* (build-int-list 100))
    (set! *ints1k*  (build-int-list 1000))
    (set! *deep100* (build-deep-sexp 100))
    (set! *flat1k*  (build-flat-sexp 1000))))

; ============================================================
; Grammars
; ============================================================

; --- kv pair ---
(defn make-kv-pair []
  (Parser.bind (Parser.Lexer.lexeme (Parser.Lexer.identifier))
    (fn [name]
      (Parser.bind (Parser.Lexer.symbol @"=")
        (fn [_]
          (Parser.map (Parser.Lexer.integer)
                      (fn [n] (Pair.init @&name n))))))))

(def p-kv (Parser.sep-by1 (make-kv-pair) (Parser.Lexer.symbol @";")))

; --- comma-separated integers ---
(def p-int-list
  (Parser.sep-by (Parser.Lexer.integer) (Parser.byte \,)))

; --- s-expression ---
(defn sym-char? [c]
  (not (or (Char.= c \space)
           (or (Char.= c \tab)
               (or (Char.= c \newline)
                   (or (Char.= c \()
                       (Char.= c \))))))))

(deftype SExp
  (Sym [String])
  (Lst [(Array (Box SExp))]))

; Pre-built recursive parser via Parser.recurse against a stable cell.
(def *sexp* (the (Parser SExp) (Parser.placeholder)))

(defn sym-p []
  (Parser.map (Parser.Lexer.lexeme
                (Parser.take-while1 (fn [c] (sym-char? c))))
              (fn [s] (SExp.Sym s))))

(defn list-p []
  (Parser.map
    (Parser.Lexer.lexeme
      (Parser.between (Parser.byte \()
                      (Parser.byte \))
                      (Parser.many (Parser.map (Parser.recurse &*sexp*)
                                               (fn [s] (Box.init s))))))
    (fn [items] (SExp.Lst items))))

(defn init-sexp [] (set! *sexp* (Parser.alt (sym-p) (list-p))))

(def p-sexp (Parser.bind (Parser.Lexer.whitespace)
                         (fn [_] (Parser.recurse &*sexp*))))

; ============================================================
; Bench helpers
; ============================================================

(defn run! [p src]
  (let [len (String.length src)
        cur (Cursor.zero)]
    (ignore (~(Parser.run p) src len &cur))))

(defn bench-kv-100      [] (run! &p-kv       &*kv100*))
(defn bench-kv-1000     [] (run! &p-kv       &*kv1000*))
(defn bench-int-100     [] (run! &p-int-list &*ints100*))
(defn bench-int-1000    [] (run! &p-int-list &*ints1k*))
(defn bench-sexp-deep   [] (run! &p-sexp     &*deep100*))
(defn bench-sexp-flat   [] (run! &p-sexp     &*flat1k*))

(defn main []
  (do
    (setup)
    (init-sexp)
    (Bench.set-min-runs! 100)
    (println "=== Carp parsec ===")
    (println "kv 100:")          (bench bench-kv-100)    (println "")
    (println "kv 1000:")         (bench bench-kv-1000)   (println "")
    (println "int-list 100:")    (bench bench-int-100)   (println "")
    (println "int-list 1000:")   (bench bench-int-1000)  (println "")
    (println "sexp deep 100:")   (bench bench-sexp-deep) (println "")
    (println "sexp flat 1000:")  (bench bench-sexp-flat) (println "")))
