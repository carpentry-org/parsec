(load "../parsec.carp")
(load "Test.carp")
(use Test)

(defn ok? [r] (match-ref r (Result.Success _) true (Result.Error _) false))

(defn err? [r] (match-ref r (Result.Success _) false (Result.Error _) true))

; Recursive grammar for the lazy combinator test. The lazy thunk must call
; a sibling function, not the immediately enclosing one — so we split into
; `parens-pair` and `parens-content`.
;   parens-pair    = '(' parens-content ')'
;   parens-content = parens-pair | empty
(sig parens-pair (Fn [] (Parser ())))
(sig parens-content (Fn [] (Parser ())))

(defn parens-pair []
  (Parser.between (Parser.byte \() (Parser.byte \)) (parens-content)))

(defn parens-content []
  (Parser.alt (Parser.lazy (fn [] (parens-pair))) (Parser.pure ())))

; Recursive grammar for the recurse combinator test. Same shape as the
; lazy test but uses a stable cell instead of rebuilding per call.
(def *r-pair* (the (Parser ()) (Parser.placeholder)))

(defn r-content [] (Parser.alt (Parser.recurse &*r-pair*) (Parser.pure ())))

(defn r-pair-impl []
  (Parser.between (Parser.byte \() (Parser.byte \)) (r-content)))

; Side-effecting init via a dummy def — runs at module load.
(def -r-init (do (set! *r-pair* (r-pair-impl)) 0))

; Helper for chainr1 tests: integer exponentiation
(defn ipow [base exp]
  (let-do [acc 1] (for [i 0 exp] (set! acc (Int.* acc base))) acc))

(deftest test
  (assert-equal test
    42
    (match (Parser.parse (Parser.pure 42) "")
      (Result.Success v) v
      (Result.Error _) 0)
    "pure produces value on empty input")

  (assert-true test
    (err? &(Parser.parse (Parser.pure 42) "x"))
    "pure leaves input unconsumed; strict parse rejects trailing")

  (assert-true test
    (err? &(Parser.parse (the (Parser Int) (Parser.fail @"thing")) ""))
    "fail always errors")

  (assert-true test
    (ok? &(Parser.parse (Parser.byte \a) "a"))
    "byte matches single char")

  (assert-true test
    (err? &(Parser.parse (Parser.byte \a) "b"))
    "byte fails on mismatch")

  (assert-true test
    (err? &(Parser.parse (Parser.byte \a) ""))
    "byte fails on empty input")

  (assert-true test
    (err? &(Parser.parse (Parser.byte \a) "ab"))
    "byte fails on trailing content (parse is strict)")

  (assert-true test
    (ok? &(Parser.parse (Parser.satisfy (fn [c] (Char.>= c \0)) @"digit") "5"))
    "satisfy accepts when pred holds")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.satisfy (fn [c] (and (Char.>= c \0) (Char.<= c \9))) @"digit")
        "a"))
    "satisfy rejects when pred fails")

  (assert-true test
    (ok? &(Parser.parse (Parser.any-byte) "x"))
    "any-byte consumes one byte")

  (assert-true test
    (err? &(Parser.parse (Parser.any-byte) ""))
    "any-byte fails on empty input")

  (assert-true test
    (ok? &(Parser.parse (Parser.eof) ""))
    "eof succeeds on empty input")

  (assert-true test
    (err? &(Parser.parse (Parser.eof) "x"))
    "eof fails when input remains")

  (assert-equal test
    65
    (match (Parser.parse
        (Parser.map (Parser.byte \A) (fn [c] (Char.to-int c)))
        "A")
      (Result.Success v) v
      (Result.Error _) 0)
    "map applies function to result")

  (assert-true test
    (ok? &(Parser.parse (Parser.seq (Parser.byte \a) (Parser.byte \b)) "ab"))
    "seq matches two adjacent bytes")

  (assert-true test
    (err? &(Parser.parse (Parser.seq (Parser.byte \a) (Parser.byte \b)) "ax"))
    "seq fails when second parser fails")

  (assert-true test
    (ok? &(Parser.parse (Parser.alt (Parser.byte \a) (Parser.byte \b)) "a"))
    "alt picks left when left empty-succeeds")

  (assert-true test
    (ok? &(Parser.parse (Parser.alt (Parser.byte \a) (Parser.byte \b)) "b"))
    "alt picks right when left empty-fails")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.alt
          (Parser.seq (Parser.byte \a) (Parser.byte \b))
          (Parser.seq (Parser.byte \a) (Parser.byte \c)))
        "ac"))
    "alt without try: consumed failure does not backtrack")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.alt
          (Parser.try (Parser.seq (Parser.byte \a) (Parser.byte \b)))
          (Parser.seq (Parser.byte \a) (Parser.byte \c)))
        "ac"))
    "try in alt: consumed-then-failure rewinds and tries the other branch")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.bind (Parser.any-byte) (fn [c] (Parser.byte c)))
        "aa"))
    "bind threads value into continuation parser")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.bind (Parser.any-byte) (fn [c] (Parser.byte c)))
        "ab"))
    "bind: continuation can fail")

  (assert-true test
    (ok? &(Parser.parse (Parser.string @"hello") "hello"))
    "string matches exact literal")

  (assert-true test
    (err? &(Parser.parse (Parser.string @"hello") "help!"))
    "string fails on partial mismatch")

  (assert-true test
    (err? &(Parser.parse (Parser.string @"hello") "hi"))
    "string fails when input shorter than literal")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.alt (Parser.string @"foo") (Parser.string @"for"))
        "for"))
    "string is atomic: alt picks second alternative even after partial match of first")

  (assert-true test
    (ok? &(Parser.parse-partial (Parser.string @"") "anything"))
    "string: empty pattern succeeds without consuming")

  (assert-true test
    (match (Parser.parse-partial (Parser.string @"") "anything")
      (Result.Success p) (and (= "" (Pair.a &p)) (= "anything" (Pair.b &p)))
      _ false)
    "string: empty pattern returns empty slice")

  (assert-true test
    (ok? &(Parser.parse (Parser.string @"") ""))
    "string: empty pattern on empty input succeeds")

  (assert-true test
    (ok? &(Parser.parse (Parser.string @"a\r\nb") "a\r\nb"))
    "string: matches CRLF line endings")

  (assert-equal test
    "a\r\nb"
    &(match (Parser.parse (Parser.string @"a\r\nb") "a\r\nb")
      (Result.Success v) v
      _ @"FAIL")
    "string: CRLF returns matched slice")

  (assert-true test
    (match (Parser.parse
        (Parser.label @"a digit"
                      (Parser.satisfy
                        (fn [c] (and (Char.>= c \0) (Char.<= c \9)))
                        @"raw"))
        "x")
      (Result.Error e)
        (let [arr (Expected.to-array (ParseErr.expected &e))]
          (= "a digit" (Array.unsafe-nth &arr 0)))
      _ false)
    "label replaces the expected-set on empty failure")

  (assert-true test
    (match (Parser.parse (Parser.optional (Parser.byte \a)) "a")
      (Result.Success m) (match m (Maybe.Just _) true (Maybe.Nothing) false)
      _ false)
    "optional wraps successful value in Just")

  (assert-true test
    (match (Parser.parse (Parser.optional (Parser.byte \a)) "")
      (Result.Success m) (match m (Maybe.Just _) false (Maybe.Nothing) true)
      _ false)
    "optional yields Nothing when p empty-fails")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.seq (Parser.lookahead (Parser.byte \a)) (Parser.byte \a))
        "a"))
    "lookahead does not consume; subsequent byte matches the same input")

  (assert-true test
    (err? &(Parser.parse (Parser.lookahead (Parser.byte \a)) "a"))
    "lookahead alone leaves cursor at start; strict parse rejects")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.seq (Parser.byte \a) (Parser.not-followed-by (Parser.byte \b)))
        "a"))
    "not-followed-by succeeds when subsequent parser would fail")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.seq (Parser.byte \a) (Parser.not-followed-by (Parser.byte \b)))
        "ab"))
    "not-followed-by fails when subsequent parser would succeed")

  (assert-true test
    (match (Parser.parse (Parser.count 3 (Parser.byte \a)) "aaa")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "count 3 returns array of 3 values on \"aaa\"")

  (assert-true test
    (err? &(Parser.parse (Parser.count 3 (Parser.byte \a)) "aa"))
    "count 3 fails on insufficient input")

  (assert-true test
    (match (Parser.parse (Parser.many (Parser.byte \a)) "")
      (Result.Success arr) (= 0 (Array.length &arr))
      _ false)
    "many on empty input yields empty array")

  (assert-true test
    (match (Parser.parse (Parser.many (Parser.byte \a)) "aaaa")
      (Result.Success arr) (= 4 (Array.length &arr))
      _ false)
    "many consumes greedily")

  (assert-true test
    (err? &(Parser.parse (Parser.many1 (Parser.byte \a)) ""))
    "many1 fails on zero matches")

  (assert-true test
    (match (Parser.parse (Parser.many1 (Parser.byte \a)) "aaa")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "many1 collects when at least one match")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.then (Parser.skip-many (Parser.byte \a)) (Parser.eof))
        "aaaa"))
    "skip-many consumes matching input and returns unit")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.then (Parser.skip-many (Parser.byte \a)) (Parser.eof))
        ""))
    "skip-many on empty input succeeds with unit")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.then (Parser.skip-many (Parser.byte \a)) (Parser.byte \b))
        "b"))
    "skip-many with no matches succeeds and leaves input for next parser")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.then (Parser.skip-many1 (Parser.byte \a)) (Parser.eof))
        "aaa"))
    "skip-many1 succeeds with one or more matches")

  (assert-true test
    (err? &(Parser.parse (Parser.skip-many1 (Parser.byte \a)) ""))
    "skip-many1 fails on empty input (no match)")

  (assert-true test
    (err? &(Parser.parse (Parser.skip-many1 (Parser.byte \a)) "b"))
    "skip-many1 fails when first application of p fails")

  (assert-true test
    (match (Parser.parse
        (Parser.many-till (Parser.byte \a) (Parser.byte \b))
        "aaab")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "many-till collects p results until end succeeds")

  (assert-true test
    (match (Parser.parse
        (Parser.many-till (Parser.byte \a) (Parser.byte \b))
        "b")
      (Result.Success arr) (= 0 (Array.length &arr))
      _ false)
    "many-till: empty collection when end matches immediately")

  (assert-true test
    (match (Parser.parse
        (Parser.many-till (Parser.any-byte) (Parser.string @"end"))
        "xyend")
      (Result.Success arr) (= 2 (Array.length &arr))
      _ false)
    "many-till: collects items before multi-byte terminator")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.between (Parser.byte \[) (Parser.byte \]) (Parser.byte \x))
        "[x]"))
    "between matches open/inner/close")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.between (Parser.byte \[) (Parser.byte \]) (Parser.byte \x))
        "[y]"))
    "between fails if inner doesn't match")

  (assert-true test
    (match (Parser.parse
        (Parser.sep-by1 (Parser.byte \a) (Parser.byte \,))
        "a,a,a")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "sep-by1: 3 elements")

  (assert-true test
    (match (Parser.parse (Parser.sep-by1 (Parser.byte \a) (Parser.byte \,)) "a")
      (Result.Success arr) (= 1 (Array.length &arr))
      _ false)
    "sep-by1: single element (no separator)")

  (assert-true test
    (err? &(Parser.parse (Parser.sep-by1 (Parser.byte \a) (Parser.byte \,)) ""))
    "sep-by1 fails on empty input")

  (assert-true test
    (match (Parser.parse (Parser.sep-by (Parser.byte \a) (Parser.byte \,)) "")
      (Result.Success arr) (= 0 (Array.length &arr))
      _ false)
    "sep-by allows empty")

  (assert-true test
    (match (Parser.parse
        (Parser.end-by1 (Parser.byte \a) (Parser.byte \;))
        "a;a;a;")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "end-by1: 3 terminated elements")

  (assert-true test
    (match (Parser.parse (Parser.end-by1 (Parser.byte \a) (Parser.byte \;)) "a;")
      (Result.Success arr) (= 1 (Array.length &arr))
      _ false)
    "end-by1: single terminated element")

  (assert-true test
    (err? &(Parser.parse (Parser.end-by1 (Parser.byte \a) (Parser.byte \;)) ""))
    "end-by1 fails on empty input")

  (assert-true test
    (err? &(Parser.parse (Parser.end-by1 (Parser.byte \a) (Parser.byte \;)) "a"))
    "end-by1 fails when terminator is missing")

  (assert-true test
    (match (Parser.parse (Parser.end-by (Parser.byte \a) (Parser.byte \;)) "")
      (Result.Success arr) (= 0 (Array.length &arr))
      _ false)
    "end-by allows empty")

  (assert-true test
    (match (Parser.parse
        (Parser.end-by (Parser.byte \a) (Parser.byte \;))
        "a;a;")
      (Result.Success arr) (= 2 (Array.length &arr))
      _ false)
    "end-by: 2 terminated elements")

  (assert-true test
    (err? &(Parser.parse (Parser.end-by (Parser.byte \a) (Parser.byte \;)) "a"))
    "end-by fails when terminator is missing after consumed element")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.choice [(Parser.byte \a) (Parser.byte \b) (Parser.byte \c)])
        "b"))
    "choice picks any matching parser")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.choice [(Parser.byte \a) (Parser.byte \b) (Parser.byte \c)])
        "z"))
    "choice fails when none match")

  (assert-equal test
    "abc"
    &(match (Parser.parse
        (Parser.slice-of
          (Parser.seq (Parser.byte \a)
                      (Parser.seq (Parser.byte \b) (Parser.byte \c))))
        "abc")
      (Result.Success s) s
      (Result.Error _) @"")
    "slice-of returns the consumed input")

  (assert-equal test
    "abc"
    &(match (Parser.parse (Parser.take 3) "abc")
      (Result.Success s) s
      (Result.Error _) @"")
    "take 3 consumes 3 bytes and returns them")

  (assert-true test
    (err? &(Parser.parse (Parser.take 5) "abc"))
    "take fails on insufficient input")

  (assert-equal test
    "123"
    &(match (Parser.parse
        (Parser.seq
          (Parser.take-while (fn [c] (and (Char.>= c \0) (Char.<= c \9))))
          (Parser.string @"abc"))
        "123abc")
      (Result.Success p) @(Pair.a &p)
      (Result.Error _) @"")
    "take-while reads digits until non-digit")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.take-while1 (fn [c] (and (Char.>= c \0) (Char.<= c \9))))
        "abc"))
    "take-while1 fails when no bytes match")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.seq (Parser.UTF8.any-char)
                    (Parser.seq (Parser.UTF8.any-char)
                                (Parser.seq (Parser.UTF8.any-char)
                                            (Parser.UTF8.any-char))))
        "café"))
    "four any-char consume café (incl. é which is 2 bytes)")

  (assert-true test
    (err? &(Parser.parse (Parser.UTF8.any-char) ""))
    "any-char fails on empty input")

  (assert-true test
    (ok? &(Parser.parse (Parser.UTF8.char \u00e9) "é"))
    "char matches multi-byte codepoint é")

  (assert-true test
    (err? &(Parser.parse (Parser.UTF8.char \u00e9) "e"))
    "char rejects different codepoint")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.UTF8.codepoint-satisfy (fn [c] (Int.> (Char.to-int c) 127))
                                       @"non-ASCII")
        "ñ"))
    "codepoint-satisfy accepts when pred holds on multi-byte cp")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.UTF8.codepoint-satisfy (fn [c] (Int.> (Char.to-int c) 127))
                                       @"non-ASCII")
        "a"))
    "codepoint-satisfy rejects when pred fails")

  (assert-true test (ok? &(Parser.parse (Parser.Lexer.whitespace) "  \t
 ")) "whitespace consumes mixed whitespace")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.whitespace) ""))
    "whitespace allows empty")

  (assert-equal test
    "hello"
    &(match (Parser.parse
        (Parser.Lexer.lexeme (Parser.string @"hello"))
        "hello   ")
      (Result.Success s) s
      (Result.Error _) @"")
    "lexeme strips trailing whitespace, returns p's value")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.symbol @"def") "def    "))
    "symbol matches literal + trailing whitespace")

  (assert-equal test
    42
    (match (Parser.parse (Parser.Lexer.unsigned-int) "42")
      (Result.Success n) n
      _ -1)
    "unsigned-int parses decimal")

  (assert-equal test
    -17
    (match (Parser.parse (Parser.Lexer.integer) "-17") (Result.Success n) n _ 0)
    "integer parses negative")

  (assert-equal test
    99
    (match (Parser.parse (Parser.Lexer.integer) "99") (Result.Success n) n _ 0)
    "integer parses positive without sign")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.unsigned-int) "99999999999999999999999"))
    "unsigned-int rejects overflow")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.integer) "99999999999999999999999"))
    "integer rejects positive overflow")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.integer) "-99999999999999999999999"))
    "integer rejects negative overflow")

  (assert-equal test
    42
    (match (Parser.parse (Parser.Lexer.unsigned-int) "042")
      (Result.Success n) n
      _ -1)
    "unsigned-int accepts leading zeros")

  (assert-equal test
    "foo_bar2"
    &(match (Parser.parse (Parser.Lexer.identifier) "foo_bar2")
      (Result.Success s) s
      (Result.Error _) @"")
    "identifier accepts letters, digits, underscores after a letter start")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.identifier) "2foo"))
    "identifier rejects digit start")

  (assert-true test
    (match (Parser.parse (Parser.byte \a) "b")
      (Result.Error e)
        (String.contains-string? &(Parser.format-error &e) "expected")
      _ false)
    "format-error mentions the expected label")

  (assert-true test
    (match (Parser.parse (Parser.byte \a) "b")
      (Result.Error e) (String.contains-string? &(Parser.format-error &e) "1:1")
      _ false)
    "format-error mentions line:col")

  (assert-true test
    (ok? &(Parser.parse (Parser.lazy (fn [] (Parser.byte \a))) "a"))
    "lazy: non-recursive thunk produces a working parser")

  (assert-true test
    (err? &(Parser.parse (Parser.lazy (fn [] (Parser.byte \a))) "b"))
    "lazy: failures of the inner parser propagate")

  (assert-true test
    (ok? &(Parser.parse (parens-pair) "()"))
    "lazy: recursive grammar parses ()")

  (assert-true test
    (ok? &(Parser.parse (parens-pair) "((()))"))
    "lazy: recursive grammar parses nested ((()))")

  (assert-true test
    (err? &(Parser.parse (parens-pair) "(()"))
    "lazy: recursive grammar rejects unbalanced (()")

  (assert-true test
    (err? &(Parser.parse (parens-pair) "())"))
    "lazy: recursive grammar rejects unbalanced ())")

  (assert-equal test
    15
    (match (Parser.parse
        (Parser.map
          (Parser.between (Parser.Lexer.symbol @"[")
                          (Parser.Lexer.symbol @"]")
                          (Parser.sep-by (Parser.Lexer.integer)
                                         (Parser.Lexer.symbol @",")))
          (fn [arr] (Array.reduce &(fn [acc n] (Int.+ acc @n)) 0 &arr)))
        "[1, 2, 3, 4, 5]")
      (Result.Success n) n
      _ -1)
    "integration: parse [1,2,3,4,5] and sum to 15")

  (assert-equal test
    0
    (match (Parser.parse
        (Parser.map
          (Parser.between (Parser.Lexer.symbol @"[")
                          (Parser.Lexer.symbol @"]")
                          (Parser.sep-by (Parser.Lexer.integer)
                                         (Parser.Lexer.symbol @",")))
          (fn [arr] (Array.length &arr)))
        "[]")
      (Result.Success n) n
      _ -1)
    "integration: empty list is valid")

  (assert-true test
    (match (Parser.parse
        (Parser.sep-by1
          (Parser.seq (Parser.Lexer.identifier)
                      (Parser.seq (Parser.Lexer.symbol @"=")
                                  (Parser.Lexer.unsigned-int)))
          (Parser.Lexer.symbol @";"))
        "x=1; y=42; z=7")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "integration: 3 key=value pairs")

  (assert-true test
    (ok? &(Parser.parse (r-pair-impl) "()"))
    "recurse: stable-cell grammar parses ()")

  (assert-true test
    (ok? &(Parser.parse (r-pair-impl) "((()))"))
    "recurse: stable-cell grammar parses nested ((()))")

  (assert-true test
    (err? &(Parser.parse (r-pair-impl) "(()"))
    "recurse: stable-cell grammar rejects unbalanced (()")

  (assert-true test
    (err? &(Parser.parse (the (Parser Int) (Parser.placeholder)) "anything"))
    "placeholder: uninitialized parser fails")

  ; Parse "a\nb" with `(seq (byte \a) (seq (byte \newline) (byte \z)))`.
  ; The byte \z fails at line 2, col 1 (newline bumped line, col reset).
  (assert-true test
    (match (Parser.parse
        (Parser.seq (Parser.byte \a)
                    (Parser.seq (Parser.byte \newline) (Parser.byte \z)))
        "a
b")
      (Result.Error e) (and (= 2 @(ParseErr.line &e)) (= 1 @(ParseErr.col &e)))
      _ false)
    "line/col: error after newline reports line 2 col 1")

  (assert-true test
    (match (Parser.parse (Parser.seq (Parser.byte \x) (Parser.byte \y)) "xz")
      (Result.Error e) (and (= 1 @(ParseErr.line &e)) (= 2 @(ParseErr.col &e)))
      _ false)
    "line/col: error after one byte reports line 1 col 2")

  ; (alt (byte \a) (byte \b)) on "z" should mention BOTH 'a' and 'b' in
  ; the expected-set.
  (assert-true test
    (match (Parser.parse (Parser.alt (Parser.byte \a) (Parser.byte \b)) "z")
      (Result.Error e) (= 2 (Expected.length (ParseErr.expected &e)))
      _ false)
    "expected-set: alt of two failed empties merges expected labels (size 2)")

  (assert-true test
    (match (Parser.parse
        (Parser.alt (Parser.label @"alpha" (Parser.byte \a))
                    (Parser.label @"beta" (Parser.byte \b)))
        "z")
      (Result.Error e)
        (and
          (= 2 (Expected.length (ParseErr.expected &e)))
          (and
            (String.contains-string? &(Parser.format-error &e) "alpha")
            (String.contains-string? &(Parser.format-error &e) "beta")))
      _ false)
    "expected-set: labeled alts merge into the human-readable error")

  ; "\xc3" is the start byte of a 2-byte UTF-8 sequence (e.g. é = c3 a9)
  ; but appears alone — truncated. any-char should fail empty.
  (assert-true test
    (err?
      &(Parser.parse (Parser.UTF8.any-char)
                     &(String.from-bytes &[(Byte.from-int 195)])))
    "utf8: truncated 2-byte sequence fails empty")

  (assert-true test
    (err?
      &(Parser.parse (Parser.UTF8.any-char)
                     &(String.from-bytes &[(Byte.from-int 128)])))
    "utf8: lone continuation byte fails empty")

  (assert-equal test
    \b
    (match (Parser.parse (Parser.then (Parser.byte \a) (Parser.byte \b)) "ab")
      (Result.Success v) v
      (Result.Error _) \x)
    "then returns second parser's value")

  (assert-true test
    (err? &(Parser.parse (Parser.then (Parser.byte \a) (Parser.byte \b)) "ax"))
    "then fails when second parser fails")

  (assert-true test
    (err? &(Parser.parse (Parser.then (Parser.byte \a) (Parser.byte \b)) "b"))
    "then fails when first parser fails")

  (assert-equal test
    \a
    (match (Parser.parse (Parser.before (Parser.byte \a) (Parser.byte \b)) "ab")
      (Result.Success v) v
      (Result.Error _) \x)
    "before returns first parser's value")

  (assert-true test
    (err? &(Parser.parse (Parser.before (Parser.byte \a) (Parser.byte \b)) "ax"))
    "before fails when second parser fails")

  (assert-true test
    (err? &(Parser.parse (Parser.before (Parser.byte \a) (Parser.byte \b)) "b"))
    "before fails when first parser fails")

  (assert-equal test
    65
    (match (Parser.parse
        (Parser.bind-result (Parser.byte \A)
                            (fn [c cur]
                              (the (Result Int ParseErr)
                                   (Result.Success (Char.to-int c)))))
        "A")
      (Result.Success v) v
      (Result.Error _) 0)
    "bind-result: success maps value through Result-returning function")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.bind-result (Parser.byte \A)
                            (fn [c cur]
                              (the (Result Int ParseErr)
                                   (Result.Error (ParseErr.expected-at cur
                                                                       @"rejected")))))
        "A"))
    "bind-result: Result.Error propagates as parse failure")

  (assert-true test
    (match (Parser.parse-partial (Parser.byte \a) "abc")
      (Result.Success p) (and (= \a @(Pair.a &p)) (= "bc" (Pair.b &p)))
      _ false)
    "parse-partial returns value and remaining input")

  (assert-true test
    (match (Parser.parse-partial (Parser.string @"abc") "abc")
      (Result.Success p) (and (= "abc" (Pair.a &p)) (= "" (Pair.b &p)))
      _ false)
    "parse-partial: full consumption yields empty remaining")

  (assert-true test
    (err? &(Parser.parse-partial (Parser.byte \a) "xyz"))
    "parse-partial: error on mismatch")

  (assert-true test
    (match (Parser.parse-partial (Parser.pure 42) "hello")
      (Result.Success p) (and (= 42 @(Pair.a &p)) (= "hello" (Pair.b &p)))
      _ false)
    "parse-partial: pure consumes nothing, all input remains")

  (assert-true test
    (match (Parser.parse (Parser.count 0 (Parser.byte \a)) "")
      (Result.Success arr) (= 0 (Array.length &arr))
      _ false)
    "count 0 succeeds with empty array on empty input")

  (assert-true test
    (match (Parser.parse (Parser.at-most 3 (Parser.byte \a)) "aaa")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "at-most 3 returns 3 elements on exact match")

  (assert-true test
    (match (Parser.parse (Parser.at-most 3 (Parser.byte \a)) "aa")
      (Result.Success arr) (= 2 (Array.length &arr))
      _ false)
    "at-most 3 returns 2 elements when only 2 available")

  (assert-true test
    (match (Parser.parse (Parser.at-most 3 (Parser.byte \a)) "")
      (Result.Success arr) (= 0 (Array.length &arr))
      _ false)
    "at-most on empty input yields empty array")

  (assert-true test
    (match (Parser.parse (Parser.at-most 0 (Parser.byte \a)) "")
      (Result.Success arr) (= 0 (Array.length &arr))
      _ false)
    "at-most 0 succeeds with empty array")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.seq (Parser.at-most 2 (Parser.byte \a)) (Parser.byte \b))
        "aab"))
    "at-most stops at limit leaving remaining input for next parser")

  (assert-true test
    (match (Parser.parse (Parser.at-least 2 (Parser.byte \a)) "aaa")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "at-least 2 greedily consumes 3 on \"aaa\"")

  (assert-true test
    (match (Parser.parse (Parser.at-least 2 (Parser.byte \a)) "aa")
      (Result.Success arr) (= 2 (Array.length &arr))
      _ false)
    "at-least 2 succeeds with exactly 2")

  (assert-true test
    (err? &(Parser.parse (Parser.at-least 2 (Parser.byte \a)) "a"))
    "at-least 2 fails on only 1 match")

  (assert-true test
    (err? &(Parser.parse (Parser.at-least 3 (Parser.byte \a)) ""))
    "at-least 3 fails on empty input")

  (assert-true test
    (match (Parser.parse (Parser.at-least 0 (Parser.byte \a)) "")
      (Result.Success arr) (= 0 (Array.length &arr))
      _ false)
    "at-least 0 on empty input yields empty array (like many)")

  (assert-true test
    (match (Parser.parse (Parser.at-least 0 (Parser.byte \a)) "aaa")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "at-least 0 greedily consumes all (like many)")

  (assert-equal test
    ""
    &(match (Parser.parse (Parser.take 0) "")
      (Result.Success s) s
      (Result.Error _) @"fail")
    "take 0 succeeds with empty string on empty input")

  (assert-true test
    (err?
      &(Parser.parse (Parser.sep-by1 (Parser.byte \a) (Parser.byte \,)) "a,"))
    "sep-by1: trailing separator causes consumed failure")

  (assert-true test
    (match (Parser.parse (Parser.UTF8.any-char)
                         &(String.from-bytes
                           &[(Byte.from-int 240)
                             (Byte.from-int 159)
                             (Byte.from-int 152)
                             (Byte.from-int 128)]))
      (Result.Success c) (= 128512 (Char.to-int c))
      _ false)
    "utf8: 4-byte codepoint (U+1F600 grinning face) decodes correctly")

  (assert-true test
    (match (Parser.parse
        (Parser.satisfy (fn [c] (and (Char.>= c \0) (Char.<= c \9))) @"digit")
        "x")
      (Result.Error e)
        (String.contains-string? &(Parser.format-error &e) "unexpected")
      _ false)
    "satisfy: error message includes unexpected token")

  (assert-true test
    (match (Parser.parse (Parser.eof) "x")
      (Result.Error e)
        (String.contains-string? &(Parser.format-error &e) "unexpected")
      _ false)
    "eof: error message includes unexpected token when input remains")

  (assert-equal test
    6
    (match (Parser.parse
        (Parser.chainl1 (Parser.Lexer.integer)
                        (Parser.map (Parser.Lexer.symbol @"+") (fn [_] Int.+)))
        "1+2+3")
      (Result.Success n) n
      _ -1)
    "chainl1: 1+2+3 = 6")

  (assert-equal test
    42
    (match (Parser.parse
        (Parser.chainl1 (Parser.Lexer.integer)
                        (Parser.map (Parser.Lexer.symbol @"+") (fn [_] Int.+)))
        "42")
      (Result.Success n) n
      _ -1)
    "chainl1: single value (no ops)")

  (assert-equal test
    -4
    (match (Parser.parse
        (Parser.chainl1 (Parser.Lexer.integer)
                        (Parser.map (Parser.Lexer.symbol @"-") (fn [_] Int.-)))
        "1-2-3")
      (Result.Success n) n
      _ 0)
    "chainl1: left-associative 1-2-3 = ((1-2)-3) = -4")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.chainl1 (Parser.Lexer.integer)
                        (Parser.map (Parser.Lexer.symbol @"+") (fn [_] Int.+)))
        ""))
    "chainl1: fails on empty input")

  (assert-equal test
    512
    (match (Parser.parse
        (Parser.chainr1 (Parser.Lexer.integer)
                        (Parser.map (Parser.Lexer.symbol @"^") (fn [_] ipow)))
        "2^3^2")
      (Result.Success n) n
      _ -1)
    "chainr1: right-associative 2^3^2 = 2^(3^2) = 512")

  (assert-equal test
    5
    (match (Parser.parse
        (Parser.chainr1 (Parser.Lexer.integer)
                        (Parser.map (Parser.Lexer.symbol @"^") (fn [_] ipow)))
        "5")
      (Result.Success n) n
      _ -1)
    "chainr1: single value (no ops)")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.chainr1 (Parser.Lexer.integer)
                        (Parser.map (Parser.Lexer.symbol @"^") (fn [_] ipow)))
        ""))
    "chainr1: fails on empty input")

  (assert-equal test
    0
    (match (Parser.parse
        (Parser.chainl (Parser.Lexer.integer)
                       (Parser.map (Parser.Lexer.symbol @"+") (fn [_] Int.+))
                       0)
        "")
      (Result.Success n) n
      _ -1)
    "chainl: returns default on empty input")

  (assert-equal test
    10
    (match (Parser.parse
        (Parser.chainl (Parser.Lexer.integer)
                       (Parser.map (Parser.Lexer.symbol @"+") (fn [_] Int.+))
                       0)
        "3+7")
      (Result.Success n) n
      _ -1)
    "chainl: works like chainl1 when input matches")

  (assert-equal test
    1
    (match (Parser.parse
        (Parser.chainr (Parser.Lexer.integer)
                       (Parser.map (Parser.Lexer.symbol @"^") (fn [_] ipow))
                       1)
        "")
      (Result.Success n) n
      _ -1)
    "chainr: returns default on empty input")

  (assert-equal test
    512
    (match (Parser.parse
        (Parser.chainr (Parser.Lexer.integer)
                       (Parser.map (Parser.Lexer.symbol @"^") (fn [_] ipow))
                       1)
        "2^3^2")
      (Result.Success n) n
      _ -1)
    "chainr: works like chainr1 when input matches")

  (assert-equal test
    123.456
    (match (Parser.parse (Parser.Lexer.float) "123.456")
      (Result.Success d) d
      _ 0.0)
    "float: basic decimal")

  (assert-equal test
    -1.5
    (match (Parser.parse (Parser.Lexer.float) "-1.5") (Result.Success d) d _ 0.0)
    "float: negative")

  (assert-equal test
    10000000000.0
    (match (Parser.parse (Parser.Lexer.float) "1e10") (Result.Success d) d _ 0.0)
    "float: exponent without decimal")

  (assert-equal test
    0.0015
    (match (Parser.parse (Parser.Lexer.float) "1.5e-3")
      (Result.Success d) d
      _ 0.0)
    "float: negative exponent")

  (assert-equal test
    1500.0
    (match (Parser.parse (Parser.Lexer.float) "1.5e+3")
      (Result.Success d) d
      _ 0.0)
    "float: positive exponent with sign")

  (assert-equal test
    42.0
    (match (Parser.parse (Parser.Lexer.float) "42") (Result.Success d) d _ 0.0)
    "float: integer-like input (no decimal point)")

  (assert-true test
    (err? &(Parser.parse (the (Parser Double) (Parser.Lexer.float)) ""))
    "float: fails on empty input")

  (assert-true test
    (err? &(Parser.parse (the (Parser Double) (Parser.Lexer.float)) "abc"))
    "float: fails on non-numeric input")

  (assert-equal test
    "Hello"
    &(match (Parser.parse (Parser.string-ci @"Hello") "Hello")
      (Result.Success s) s
      (Result.Error _) @"")
    "string-ci: exact case match returns input slice")

  (assert-equal test
    "HELLO"
    &(match (Parser.parse (Parser.string-ci @"hello") "HELLO")
      (Result.Success s) s
      (Result.Error _) @"")
    "string-ci: different case matches, returns input slice")

  (assert-equal test
    "hElLo"
    &(match (Parser.parse (Parser.string-ci @"HeLLo") "hElLo")
      (Result.Success s) s
      (Result.Error _) @"")
    "string-ci: mixed case matches")

  (assert-true test
    (err? &(Parser.parse (Parser.string-ci @"hello") "world"))
    "string-ci: fails on mismatch")

  (assert-true test
    (err? &(Parser.parse (Parser.string-ci @"hello") "hel"))
    "string-ci: fails when input shorter than literal")

  (assert-equal test
    "FOO123"
    &(match (Parser.parse (Parser.string-ci @"foo123") "FOO123")
      (Result.Success s) s
      (Result.Error _) @"")
    "string-ci: non-alpha chars unaffected by case folding")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.alt (Parser.string-ci @"foo") (Parser.string-ci @"for"))
        "FOR"))
    "string-ci: atomic, alt picks second after partial mismatch of first")

  (assert-true test
    (match (Parser.parse (Parser.string-ci @"") "")
      (Result.Success s) (= "" &s)
      _ false)
    "string-ci: empty string matches empty input")

  (assert-true test
    (match (Parser.parse (Parser.range 2 4 (Parser.byte \a)) "aa")
      (Result.Success arr) (= 2 (Array.length &arr))
      _ false)
    "range 2-4: exact min on \"aa\"")

  (assert-true test
    (match (Parser.parse (Parser.range 2 4 (Parser.byte \a)) "aaaa")
      (Result.Success arr) (= 4 (Array.length &arr))
      _ false)
    "range 2-4: exact max on \"aaaa\"")

  (assert-true test
    (match (Parser.parse (Parser.range 2 4 (Parser.byte \a)) "aaa")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "range 2-4: between min and max on \"aaa\"")

  (assert-true test
    (err? &(Parser.parse (Parser.range 2 4 (Parser.byte \a)) "a"))
    "range 2-4: fails below min")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.seq (Parser.range 2 4 (Parser.byte \a)) (Parser.byte \b))
        "aaaab"))
    "range 2-4: greedy stops at max, leaves remaining for next parser")

  (assert-true test
    (match (Parser.parse (Parser.range 0 3 (Parser.byte \a)) "")
      (Result.Success arr) (= 0 (Array.length &arr))
      _ false)
    "range 0-3: min 0 allows empty")

  (assert-true test
    (match (Parser.parse (Parser.range 3 3 (Parser.byte \a)) "aaa")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "range 3-3: min=max behaves like count")

  (assert-true test
    (err? &(Parser.parse (Parser.range 3 3 (Parser.byte \a)) "aa"))
    "range 3-3: fails when fewer than required")

  (assert-true test
    (match (Parser.parse-partial (Parser.Lexer.line-comment @"//") "// hello
rest") (Result.Success p) (= "
rest" (Pair.b &p)) _ false)
    "line-comment: consumes to EOL, newline not consumed")

  (assert-true test
    (match (Parser.parse-partial (Parser.Lexer.line-comment @"//") "// hello")
      (Result.Success p) (= "" (Pair.b &p))
      _ false)
    "line-comment: consumes to EOF when no newline")

  (assert-true test
    (match (Parser.parse-partial (Parser.Lexer.line-comment @"//") "//
rest") (Result.Success p) (= "
rest" (Pair.b &p)) _ false)
    "line-comment: empty comment body")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.line-comment @"//") "//"))
    "line-comment: just prefix at EOF")

  (assert-true test
    (err? &(Parser.parse-partial (Parser.Lexer.line-comment @"//") "hello"))
    "line-comment: fails when prefix doesn't match")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.then (Parser.Lexer.line-comment @"--")
                     (Parser.then (Parser.byte \newline) (Parser.string @"ok")))
        "-- comment
ok"))
    "line-comment: composes with following parsers after newline")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.block-comment @"/*" @"*/") "/* hello */"))
    "block-comment: basic comment")

  (assert-true test
    (ok?
      &(Parser.parse (Parser.Lexer.block-comment @"/*" @"*/")
                     "/* /* inner */ outer */"))
    "block-comment: nested comments")

  (assert-true test
    (ok?
      &(Parser.parse (Parser.Lexer.block-comment @"/*" @"*/")
                     "/* /* /* deep */ */ */"))
    "block-comment: deeply nested (3 levels)")

  (assert-true test
    (err?
      &(Parser.parse-partial (Parser.Lexer.block-comment @"/*" @"*/")
                             "/* unclosed"))
    "block-comment: unclosed comment fails (consumed)")

  (assert-true test
    (err?
      &(Parser.parse-partial (Parser.Lexer.block-comment @"/*" @"*/") "hello"))
    "block-comment: fails when open delimiter doesn't match")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.block-comment @"/*" @"*/") "/**/"))
    "block-comment: empty comment body")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.block-comment @"/*" @"*/") "/* line1
line2 */"))
    "block-comment: spans multiple lines")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.block-comment @"{-" @"-}") "{- hello -}"))
    "block-comment: different delimiters ({- -})")

  (assert-true test
    (match (Parser.parse-partial (Parser.Lexer.block-comment @"/*" @"*/")
                                 "/* comment */rest")
      (Result.Success p) (= "rest" (Pair.b &p))
      _ false)
    "block-comment: leaves unconsumed input after close delimiter")

  (assert-equal test
    \a
    (match (Parser.parse (Parser.option \z (Parser.byte \a)) "a")
      (Result.Success v) v
      (Result.Error _) \x)
    "option: returns p's value on success")

  (assert-equal test
    \z
    (match (Parser.parse (Parser.option \z (Parser.byte \a)) "")
      (Result.Success v) v
      (Result.Error _) \x)
    "option: returns default on empty failure")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.option \z (Parser.then (Parser.byte \a) (Parser.byte \b)))
        "ax"))
    "option: consumed failure propagates")

  (assert-true test
    (ok? &(Parser.parse (Parser.skip (Parser.byte \a)) "a"))
    "skip: succeeds when inner parser succeeds")

  (assert-true test
    (err? &(Parser.parse (Parser.skip (Parser.byte \a)) "b"))
    "skip: fails when inner parser fails")

  (assert-true test
    (ok?
      &(Parser.parse
        (Parser.seq (Parser.skip (Parser.byte \a)) (Parser.byte \b))
        "ab"))
    "skip: consumes input, next parser sees remaining")

  (assert-true test
    (match (Parser.parse
        (Parser.sep-end-by1 (Parser.byte \a) (Parser.byte \,))
        "a,a,a")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "sep-end-by1: 3 elements without trailing sep")

  (assert-true test
    (match (Parser.parse
        (Parser.sep-end-by1 (Parser.byte \a) (Parser.byte \,))
        "a,a,a,")
      (Result.Success arr) (= 3 (Array.length &arr))
      _ false)
    "sep-end-by1: 3 elements with trailing sep")

  (assert-true test
    (match (Parser.parse
        (Parser.sep-end-by1 (Parser.byte \a) (Parser.byte \,))
        "a")
      (Result.Success arr) (= 1 (Array.length &arr))
      _ false)
    "sep-end-by1: single element")

  (assert-true test
    (match (Parser.parse
        (Parser.sep-end-by1 (Parser.byte \a) (Parser.byte \,))
        "a,")
      (Result.Success arr) (= 1 (Array.length &arr))
      _ false)
    "sep-end-by1: single element with trailing sep")

  (assert-true test
    (err?
      &(Parser.parse (Parser.sep-end-by1 (Parser.byte \a) (Parser.byte \,)) ""))
    "sep-end-by1: fails on empty input")

  (assert-true test
    (match (Parser.parse
        (Parser.sep-end-by (Parser.byte \a) (Parser.byte \,))
        "")
      (Result.Success arr) (= 0 (Array.length &arr))
      _ false)
    "sep-end-by: allows empty")

  (assert-true test
    (match (Parser.parse
        (Parser.sep-end-by (Parser.byte \a) (Parser.byte \,))
        "a,a,")
      (Result.Success arr) (= 2 (Array.length &arr))
      _ false)
    "sep-end-by: 2 elements with trailing sep")

  (assert-true test
    (match (Parser.parse
        (Parser.sep-end-by (Parser.byte \a) (Parser.byte \,))
        "a,a")
      (Result.Success arr) (= 2 (Array.length &arr))
      _ false)
    "sep-end-by: 2 elements without trailing sep")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.digit) "5"))
    "Lexer.digit: matches digit")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.digit) "a"))
    "Lexer.digit: rejects non-digit")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.letter) "a"))
    "Lexer.letter: matches lowercase")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.letter) "Z"))
    "Lexer.letter: matches uppercase")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.letter) "5"))
    "Lexer.letter: rejects digit")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.upper) "A"))
    "Lexer.upper: matches uppercase")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.upper) "a"))
    "Lexer.upper: rejects lowercase")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.lower) "a"))
    "Lexer.lower: matches lowercase")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.lower) "A"))
    "Lexer.lower: rejects uppercase")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.alpha-num) "a"))
    "Lexer.alpha-num: matches letter")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.alpha-num) "5"))
    "Lexer.alpha-num: matches digit")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.alpha-num) "!"))
    "Lexer.alpha-num: rejects punctuation")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.space) " "))
    "Lexer.space: matches space")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.space) "\t"))
    "Lexer.space: matches tab")

  (assert-true test (ok? &(Parser.parse (Parser.Lexer.space) "
")) "Lexer.space: matches newline")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.space) "a"))
    "Lexer.space: rejects non-whitespace")

  (assert-equal test
    255
    (match (Parser.parse (Parser.Lexer.hex-int) "0xFF")
      (Result.Success n) n
      _ -1)
    "hex-int: 0xFF = 255")

  (assert-equal test
    255
    (match (Parser.parse (Parser.Lexer.hex-int) "0XFF")
      (Result.Success n) n
      _ -1)
    "hex-int: 0XFF uppercase prefix")

  (assert-equal test
    255
    (match (Parser.parse (Parser.Lexer.hex-int) "0xff")
      (Result.Success n) n
      _ -1)
    "hex-int: 0xff lowercase digits")

  (assert-equal test
    171
    (match (Parser.parse (Parser.Lexer.hex-int) "0xAb")
      (Result.Success n) n
      _ -1)
    "hex-int: 0xAb mixed case digits")

  (assert-equal test
    0
    (match (Parser.parse (Parser.Lexer.hex-int) "0x0") (Result.Success n) n _ -1)
    "hex-int: 0x0 = 0")

  (assert-equal test
    0
    (match (Parser.parse (Parser.Lexer.hex-int) "0x00")
      (Result.Success n) n
      _ -1)
    "hex-int: leading zeros")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.hex-int) ""))
    "hex-int: fails on empty input")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.hex-int) "FF"))
    "hex-int: fails without 0x prefix")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.hex-int) "0x"))
    "hex-int: fails with prefix but no digits")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.hex-int) "0xg"))
    "hex-int: fails with prefix but invalid digit")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.hex-int) "0xFFFFFFFFFFFFFFFF"))
    "hex-int: rejects overflow")

  (assert-equal test
    8
    (match (Parser.parse (Parser.Lexer.octal-int) "0o10")
      (Result.Success n) n
      _ -1)
    "octal-int: 0o10 = 8")

  (assert-equal test
    8
    (match (Parser.parse (Parser.Lexer.octal-int) "0O10")
      (Result.Success n) n
      _ -1)
    "octal-int: 0O10 uppercase prefix")

  (assert-equal test
    255
    (match (Parser.parse (Parser.Lexer.octal-int) "0o377")
      (Result.Success n) n
      _ -1)
    "octal-int: 0o377 = 255")

  (assert-equal test
    0
    (match (Parser.parse (Parser.Lexer.octal-int) "0o0")
      (Result.Success n) n
      _ -1)
    "octal-int: 0o0 = 0")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.octal-int) ""))
    "octal-int: fails on empty input")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.octal-int) "0o"))
    "octal-int: fails with prefix but no digits")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.octal-int) "0o8"))
    "octal-int: rejects digit 8")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.octal-int) "0o7777777777777777777777"))
    "octal-int: rejects overflow")

  (assert-equal test
    5
    (match (Parser.parse (Parser.Lexer.binary-int) "0b101")
      (Result.Success n) n
      _ -1)
    "binary-int: 0b101 = 5")

  (assert-equal test
    5
    (match (Parser.parse (Parser.Lexer.binary-int) "0B101")
      (Result.Success n) n
      _ -1)
    "binary-int: 0B101 uppercase prefix")

  (assert-equal test
    255
    (match (Parser.parse (Parser.Lexer.binary-int) "0b11111111")
      (Result.Success n) n
      _ -1)
    "binary-int: 0b11111111 = 255")

  (assert-equal test
    0
    (match (Parser.parse (Parser.Lexer.binary-int) "0b0")
      (Result.Success n) n
      _ -1)
    "binary-int: 0b0 = 0")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.binary-int) ""))
    "binary-int: fails on empty input")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.binary-int) "0b"))
    "binary-int: fails with prefix but no digits")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.binary-int) "0b2"))
    "binary-int: rejects digit 2")

  (assert-true test
    (err?
      &(Parser.parse (Parser.Lexer.binary-int)
                     "0b1111111111111111111111111111111111111111111111111111111111111111"))
    "binary-int: rejects overflow (64 ones)")

  (assert-true test
    (err?
      &(Parser.parse
        (Parser.lookahead (Parser.seq (Parser.byte \a) (Parser.byte \b)))
        "ax"))
    "lookahead: consumed failure of inner parser propagates")

  (assert-true test
    (ok?
      &(Parser.parse-partial
        (Parser.then (Parser.byte \a)
                     (Parser.not-followed-by
                       (Parser.seq (Parser.byte \b) (Parser.byte \c))))
        "ab"))
    "not-followed-by: inner consumed failure counts as failure (succeeds)")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.block-comment @"<!" @"!>") "<!hello!>"))
    "block-comment overlapping delimiters: delimiters share '!' char")

  (assert-true test
    (ok? &(Parser.parse (Parser.Lexer.block-comment @"(*" @"*)") "(***)"))
    "block-comment overlapping delimiters: *** contains close then leftover")

  (assert-equal test
    150
    (match (Parser.parse
        (Parser.chainl1 (Parser.Lexer.integer)
                        (Parser.alt
                          (Parser.map (Parser.Lexer.symbol @"+") (fn [_] Int.+))
                          (Parser.map (Parser.Lexer.symbol @"*") (fn [_] Int.*))))
        "2+3*4+5*6")
      (Result.Success n) n
      _ -1)
    "chainl1: mixed ops left-assoc ((((2+3)*4)+5)*6) = 150")

  (assert-true test
    (err? &(Parser.parse (Parser.string-ci @"") "hello"))
    "string-ci: empty pattern on non-empty input fails (trailing unconsumed)")

  (assert-true test
    (err? &(Parser.parse (Parser.range 5 3 (Parser.byte \a)) "aaa"))
    "range lo>hi: mandatory phase demands lo=5, fails when only 3 available")

  (assert-equal test
    1
    (match (Parser.parse (Parser.Lexer.hex-int) "0x1") (Result.Success n) n _ -1)
    "hex-int: single digit 0x1 = 1")

  (assert-equal test
    1
    (match (Parser.parse (Parser.Lexer.octal-int) "0o1")
      (Result.Success n) n
      _ -1)
    "octal-int: single digit 0o1 = 1")

  (assert-equal test
    1
    (match (Parser.parse (Parser.Lexer.binary-int) "0b1")
      (Result.Success n) n
      _ -1)
    "binary-int: single digit 0b1 = 1")

  (assert-equal test
    0
    (match (Parser.parse (Parser.Lexer.octal-int) "0o00")
      (Result.Success n) n
      _ -1)
    "octal-int: leading zeros 0o00 = 0")

  (assert-equal test
    0
    (match (Parser.parse (Parser.Lexer.binary-int) "0b00")
      (Result.Success n) n
      _ -1)
    "binary-int: leading zeros 0b00 = 0")

  (assert-true test
    (match (Parser.parse-partial (Parser.Lexer.hex-int) "0xFFrest")
      (Result.Success p) (and (= 255 @(Pair.a &p)) (= "rest" (Pair.b &p)))
      _ false)
    "hex-int: parse-partial stops at non-hex byte")

  (assert-true test
    (match (Parser.parse-partial (Parser.Lexer.octal-int) "0o77rest")
      (Result.Success p) (and (= 63 @(Pair.a &p)) (= "rest" (Pair.b &p)))
      _ false)
    "octal-int: parse-partial stops at non-octal byte")

  (assert-true test
    (match (Parser.parse-partial (Parser.Lexer.binary-int) "0b11rest")
      (Result.Success p) (and (= 3 @(Pair.a &p)) (= "rest" (Pair.b &p)))
      _ false)
    "binary-int: parse-partial stops at non-binary byte")

  (assert-equal test
    255
    (match (Parser.parse
        (Parser.choice
          [(Parser.Lexer.hex-int)
           (Parser.Lexer.octal-int)
           (Parser.Lexer.binary-int)])
        "0xFF")
      (Result.Success n) n
      _ -1)
    "radix choice: picks hex-int for 0xFF")

  (assert-equal test
    8
    (match (Parser.parse
        (Parser.choice
          [(Parser.Lexer.hex-int)
           (Parser.Lexer.octal-int)
           (Parser.Lexer.binary-int)])
        "0o10")
      (Result.Success n) n
      _ -1)
    "radix choice: picks octal-int for 0o10")

  (assert-equal test
    5
    (match (Parser.parse
        (Parser.choice
          [(Parser.Lexer.hex-int)
           (Parser.Lexer.octal-int)
           (Parser.Lexer.binary-int)])
        "0b101")
      (Result.Success n) n
      _ -1)
    "radix choice: picks binary-int for 0b101")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.hex-int) "0"))
    "hex-int: bare '0' too short for prefix")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.octal-int) "0"))
    "octal-int: bare '0' too short for prefix")

  (assert-true test
    (err? &(Parser.parse (Parser.Lexer.binary-int) "0"))
    "binary-int: bare '0' too short for prefix"))
