; A small key-value config parser.
;
; Grammar (whitespace-tolerant):
;   config = pair (';' pair)*
;   pair   = identifier '=' integer
;
; Returns Array of (Pair String Int).

(load "../parsec.carp")

; One key-value pair, monadic style: capture identifier and integer,
; discard the '=' separator.
(defn pair []
  (Parser.bind (Parser.Lexer.lexeme (Parser.Lexer.identifier))
    (fn [name]
      (Parser.bind (Parser.Lexer.symbol @"=")
        (fn [_]
          (Parser.map (Parser.Lexer.integer)
                      (fn [n] (Pair.init @&name n))))))))

; Whole config: pairs separated by ';' (with optional whitespace via lexeme).
(defn config []
  (Parser.sep-by1 (pair) (Parser.Lexer.symbol @";")))

; Pretty-print one pair.
(defn show-pair [p]
  (fmt "  %s -> %d" (Pair.a p) @(Pair.b p)))

(defn run-on [input]
  (do
    (IO.println &(fmt "input: %s" input))
    (match (Parser.parse (config) input)
      (Result.Success pairs)
        (do
          (IO.println "ok:")
          (for [i 0 (Array.length &pairs)]
            (IO.println &(show-pair (Array.unsafe-nth &pairs i)))))
      (Result.Error e)
        (IO.println &(fmt "error: %s" &(Parser.format-error &e))))
    (IO.println "")))

(defn main []
  (do
    (run-on "alice = 30; bob = 25; charlie = 42")
    (run-on "x = -7")
    (run-on "  ; nope")
    (run-on "name = forty-two")))
