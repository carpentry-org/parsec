; A minimal Lisp parser: symbols and lists.
;
; Grammar:
;   sexp   = symbol | list
;   list   = '(' sexp* ')'
;   symbol = identifier
;
; Whitespace is allowed anywhere via the Lexer combinators.
; The recursion (list contains sexp contains list) is broken with
; `Parser.lazy`, which defers parser construction to run time.

(load "../parsec.carp")

(deftype SExp
  (Sym [String])
  (Lst [(Array (Box SExp))]))

(defmodule SExp
  (defn str [s]
    (match-ref s
      (Sym n) @n
      (Lst items)
        (let-do [out @"("]
          (for [i 0 (Array.length items)]
            (do
              (when (Int.> i 0) (set! out (String.append &out " ")))
              (set! out (String.append &out
                          &(SExp.str (Box.peek (Array.unsafe-nth items i)))))))
          (String.append &out ")"))))
  (implements str SExp.str))

; Lisp symbols are any run of non-whitespace, non-paren bytes.
(defn symbol-char? [c]
  (not (or (Char.= c \space)
           (or (Char.= c \tab)
               (or (Char.= c \newline)
                   (or (Char.= c \()
                       (Char.= c \))))))))

; Forward-declare sexp so list-p can reference it inside `lazy`.
(sig sexp (Fn [] (Parser SExp)))

(defn symbol-p []
  (Parser.map
    (Parser.Lexer.lexeme
      (Parser.label @"symbol"
        (Parser.take-while1 (fn [c] (symbol-char? c)))))
    (fn [s] (SExp.Sym s))))

(defn list-p []
  (Parser.map
    (Parser.Lexer.lexeme
      (Parser.between
        (Parser.Lexer.symbol @"(")
        (Parser.Lexer.symbol @")")
        (Parser.many (Parser.lazy (fn [] (sexp))))))
    (fn [items]
      (SExp.Lst (Array.copy-map &(fn [s] (Box.init @s)) &items)))))

(defn sexp [] (Parser.alt (symbol-p) (list-p)))

; Top-level: skip leading whitespace, then parse one sexp.
(defn top []
  (Parser.bind (Parser.Lexer.whitespace) (fn [_] (sexp))))

(defn run-on [input]
  (do
    (IO.println &(fmt "input: %s" input))
    (match (Parser.parse (top) input)
      (Result.Success ast) (IO.println &(fmt "  -> %s" &(SExp.str &ast)))
      (Result.Error e)     (IO.println &(fmt "  err: %s" &(Parser.format-error &e))))))

(defn main []
  (do
    (run-on "hello")
    (run-on "(a b c)")
    (run-on "(define (square x) (* x x))")
    (run-on "  ( a   ( b c ) ( d ( e ) ) )  ")
    (run-on "(unclosed")
    (run-on "()")))
